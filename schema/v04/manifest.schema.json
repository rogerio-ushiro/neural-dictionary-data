{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neural-dictionary/schema/v04/manifest.schema.json",
  "title": "Pack manifest v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "packs"],
  "properties": {
    "manifest_version": { "type": "integer", "minimum": 0 },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "hash"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}

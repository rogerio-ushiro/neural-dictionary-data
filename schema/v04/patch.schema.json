{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neural-dictionary/schema/v04/patch.schema.json",
  "title": "Incremental patch v0.4",
  "description": "snapshot + delta between two versions of one pack (spec §43). Story 4 defines op payloads; the exact revision-bump rule is D14.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "from", "to", "ops"],
  "properties": {
    "pack": { "type": "string", "minLength": 1 },
    "from": { "type": "integer", "minimum": 0 },
    "to": { "type": "integer", "minimum": 1 },
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {
            "enum": [
              "ADD_CONCEPT",
              "UPDATE_CONCEPT",
              "ADD_ASSOCIATION",
              "UPDATE_ASSOCIATION",
              "REMOVE_ASSOCIATION"
            ]
          }
        }
      }
    }
  }
}

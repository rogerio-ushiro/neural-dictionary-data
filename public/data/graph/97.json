{
  "shard": "97",
  "concepts": {
    "c_0264": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Scritto in cui si espone e si difende un'idea su un argomento.",
        "example": "Ha pubblicato un saggio sulla storia della cucina."
      }
    },
    "c_0358": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualità di ciò che è gradevole a vedersi o a sentirsi e suscita ammirazione.",
        "example": "Si fermò a contemplare la bellezza del paesaggio."
      }
    },
    "c_0534": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il diffondersi di un'onda, di un suono o di una notizia da un punto verso lo spazio circostante.",
        "example": "La propagazione del suono è più lenta di quella della luce."
      }
    },
    "c_0808": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Strato uniforme che ricopre una superficie, come l'erba di un prato.",
        "example": "Un manto d'erba fresca copriva la radura."
      }
    },
    "c_0897": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pianta legnosa più bassa di un albero, ramificata fin dal suolo.",
        "example": "Ha potato gli arbusti di lavanda lungo il muretto."
      }
    },
    "c_0912": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Crescere folto e abbondante, detto della vegetazione.",
        "example": "Con le piogge il giardino cominciò a lussureggiare."
      }
    }
  },

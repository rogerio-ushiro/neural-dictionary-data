{
  "shard": "8e",
  "concepts": {
    "c_0348": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme dei rami e delle foglie di un albero.",
        "example": "Il vento agitava le fronde dei pini."
      }
    },
    "c_0465": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grande frutto estivo dalla scorza verde e dalla polpa rossa, acquosa e dolce, con semi neri.",
        "example": "Tagliarono il cocomero a fette sul tavolo del giardino."
      }
    },
    "c_0591": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Abbronzatura, colore dorato che la pelle prende al sole (voce familiare).",
        "example": "È tornata dal mare con una bella tintarella."
      }
    },
    "c_0634": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il non avere o il non esserci di qualcosa di necessario.",
        "example": "La mancanza di sonno lo rendeva irritabile."
      }
    },
    "c_0818": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il carattere di fondo di una persona, il suo modo naturale di essere.",
        "example": "Ha un'indole tranquilla, difficile da far arrabbiare."
      }
    },
    "c_0906": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Buca profonda scavata nel terreno per attingere l'acqua sotterranea.",
        "example": "Calarono il secchio nel pozzo per tirare su l'acqua fresca."
      }
    }
  },

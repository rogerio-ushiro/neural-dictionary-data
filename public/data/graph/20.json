{
  "shard": "20",
  "concepts": {
    "c_0269": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Opera teatrale, di solito seria, che mette in scena un conflitto.",
        "example": "La compagnia porta in scena un dramma dell'Ottocento."
      }
    },
    "c_0320": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Animale visto nella sua natura istintiva e priva di ragione; si usa come insulto per chi si comporta in modo rozzo o crudele.",
        "example": "Nel bosco si sentivano i versi di qualche bestia."
      }
    },
    "c_0355": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gas presente nell'aria indispensabile alla respirazione, prodotto dalle piante alla luce del sole.",
        "example": "In alta montagna l'ossigeno è più rarefatto."
      }
    },
    "c_0539": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La riva rialzata che contiene le acque di un fiume o di un lago.",
        "example": "Il fiume ha rotto gli argini allagando la sponda."
      }
    },
    "c_0805": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tratto di terreno pianeggiante ed erboso.",
        "example": "Attraversarono una piana coltivata a girasoli."
      }
    },
    "c_0870": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Parte posteriore e sporgente del piede, sotto la caviglia.",
        "example": "Le scarpe nuove gli hanno fatto una vescica al calcagno."
      }
    },
    "c_1046": {
      "revision": 2,
      "region_id": "r_concetti_astratti",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Attenzione costante che si dedica a mantenere qualcosa in buono stato o a far guarire qualcuno.",
        "example": "La pianta è sopravvissuta solo grazie alle sue cure."
      }
    }
  },

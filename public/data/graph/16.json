      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Veicolo motorizzato che traina i vagoni di un treno lungo i binari.",
        "example": "La locomotiva a vapore è esposta al museo dei trasporti."
      }
    },
    "c_0450": {
      "revision": 2,

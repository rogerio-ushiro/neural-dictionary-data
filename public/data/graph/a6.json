{
  "shard": "a6",
  "concepts": {
    "c_0018": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di fogli stampati e rilegati che si leggono; contiene un racconto, uno studio o informazioni.",
        "example": "Ha finito il libro in una notte."
      }
    },
    "c_0087": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La stagione tra l'estate e l'inverno, quando le foglie ingialliscono e cadono.",
        "example": "In autunno il bosco si tinge di rosso e di giallo."
      }
    },
    "c_0173": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di persone legate da un luogo, da interessi o da valori comuni.",
        "example": "La comunità del paese si è stretta attorno alle famiglie colpite."
      }
    },
    "c_0700": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di persone o cose riunite in un unico complesso.",
        "example": "Un gruppo di turisti aspettava la guida davanti al museo."
      }
    }
  },

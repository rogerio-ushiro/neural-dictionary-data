{
  "shard": "2f",
  "concepts": {
    "c_0008": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Convoglio di vagoni trainati su rotaia da una locomotiva, usato per trasportare persone o merci tra le stazioni.",
        "example": "Il treno per Milano parte dal binario quattro."
      }
    },
    "c_0101": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Giorni di riposo retribuito che spettano al lavoratore ogni anno.",
        "example": "Prende le ferie sempre nella seconda metà di agosto."
      }
    },
    "c_0484": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pranzo festoso in compagnia; anche l'insieme dei convitati.",
        "example": "Il convivio si protrasse tra racconti e risate."
      }
    },
    "c_0710": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che qualcuno fa concretamente per ottenere un risultato, in contrapposizione alle sole parole o intenzioni.",
        "example": "È il momento di passare all'azione."
      }
    },
    "c_0765": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il primo antenato da cui discende una famiglia o un popolo.",
        "example": "Il capostipite arrivò in questa valle tre secoli fa."
      }
    }
  },

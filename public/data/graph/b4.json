{
  "shard": "b4",
  "concepts": {
    "c_0463": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo frutto secco dal guscio tondo e legnoso, con dentro un seme dolce.",
        "example": "Sgusciava nocciole davanti al camino."
      }
    },
    "c_0597": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il tono che assume la pelle esposta al sole.",
        "example": "La colorazione del viso rivelava molte ore all'aperto."
      }
    },
    "c_0632": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il non esserci di qualcuno o qualcosa in un luogo o in un momento.",
        "example": "Durante la sua assenza qualcuno ha annaffiato le piante."
      }
    },
    "c_0900": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Getto d'acqua che schizza verso l'alto da una fontana.",
        "example": "Lo zampillo centrale della fontana arrivava fino a due metri."
      }
    }
  },

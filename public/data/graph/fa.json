{
  "shard": "fa",
  "concepts": {
    "c_0050": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Voragine profondissima, di solito in mare, di cui non si vede il fondo; al figurato, una condizione di rovina senza scampo.",
        "example": "Gli studiosi calarono le sonde nell'abisso oceanico."
      }
    },
    "c_0124": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle soste di un viaggio, e il tratto percorso tra una sosta e l'altra.",
        "example": "La seconda tappa del giro si conclude in salita."
      }
    },
    "c_0748": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Successione di sovrani o di membri di una stessa famiglia al potere.",
        "example": "La dinastia regnò per oltre due secoli."
      }
    }
  },

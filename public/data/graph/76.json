{
  "shard": "76",
  "concepts": {
    "c_0106": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Senso di alleggerimento che si prova quando cessa un fastidio o una pena.",
        "example": "Tirò un respiro di sollievo alla notizia."
      }
    },
    "c_0483": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pranzo o cena solenne e abbondante per molti invitati.",
        "example": "Il banchetto di nozze durò fino a sera."
      }
    },
    "c_0717": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Linea curva chiusa i cui punti sono tutti alla stessa distanza dal centro; anche un gruppo ristretto di persone unite da un interesse.",
        "example": "I bambini si misero in cerchio per il gioco."
      }
    },
    "c_0762": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Animale privo di ragione visto solo nella sua parte istintiva; come insulto, persona violenta e senza sensibilità.",
        "example": "Si comportò da bruto e tutti lo evitarono."
      }
    },
    "c_0788": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Racconto di fatti veri o inventati che si narra a qualcuno; con l'iniziale maiuscola, lo studio del passato dell'umanità e degli avvenimenti che l'hanno segnato.",
        "example": "Ogni sera raccontava ai figli una storia prima di dormire."
      }
    }
  },

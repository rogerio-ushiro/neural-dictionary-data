{
  "shard": "4f",
  "concepts": {
    "c_0219": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che è nell'età tra l'infanzia e la maturità; anche fresco e appena formato.",
        "example": "Da giovane ha girato l'Europa in autostop."
      }
    },
    "c_0336": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Emettere il verso lamentoso e prolungato tipico del gatto.",
        "example": "Il gatto miagolava davanti alla porta chiusa."
      }
    },
    "c_0549": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La fascia di terra che costeggia il mare, dove si affacciano porti e stabilimenti balneari; come aggettivo, ciò che riguarda questa zona.",
        "example": "D'estate il littorale si riempie di ombrelloni."
      }
    },
    "c_0866": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Punto in cui due ossa si uniscono e lasciano piegare o ruotare una parte del corpo; in senso figurato, il modo in cui un discorso o un'organizzazione è suddiviso in parti collegate.",
        "example": "Dopo la corsa sentiva dolore alle articolazioni delle ginocchia."
      }
    },
    "c_0888": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il manto folto e morbido di peli di certi animali, usato anche per capi di abbigliamento.",
        "example": "La volpe ha una pelliccia rossiccia e spessa."
      }
    }
  },

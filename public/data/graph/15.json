{
  "shard": "15",
  "concepts": {
    "c_0293": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bevuta e mangiata smodata in compagnia rumorosa.",
        "example": "Dopo la vittoria fu gozzoviglia fino a notte fonda."
      }
    },
    "c_0424": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno dei momenti della giornata in cui si mangia.",
        "example": "Salta spesso il pasto di mezzogiorno per lavoro."
      }
    },
    "c_0640": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Caldo umido e soffocante che toglie il respiro nelle giornate estive.",
        "example": "L'afa di agosto rendeva impossibile lavorare."
      }
    },
    "c_0932": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccola quantità di liquido lanciata all'improvviso che macchia o bagna; indica anche un disegno rapido fatto per fissare un'idea.",
        "example": "Passando, l'auto gli lasciò uno schizzo di fango sui pantaloni."
      }
    },
    "c_0947": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle porzioni in cui un tutto si può dividere.",
        "example": "Ha diviso la torta in otto parti uguali."
      }
    }
  },

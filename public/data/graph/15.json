      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bevuta e mangiata smodata in compagnia rumorosa.",
        "example": "Dopo la vittoria fu gozzoviglia fino a notte fonda."
      }
    },
    "c_0424": {
      "revision": 2,

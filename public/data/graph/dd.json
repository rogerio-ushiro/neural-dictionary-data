{
  "shard": "dd",
  "concepts": {
    "c_0132": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Dispositivo che rallenta o ferma un veicolo premendo su ruote o dischi.",
        "example": "Tirò il freno a mano in discesa."
      }
    },
    "c_0147": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi dispositivo che serve a tenere serrato un contenitore o un indumento.",
        "example": "La chiusura della borsa si è inceppata."
      }
    },
    "c_0756": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Essere umano considerato singolarmente, con la sua identità e dignità.",
        "example": "Non conosceva una sola persona in quella città."
      }
    },
    "c_0998": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Assenza di rumori e di voci.",
        "example": "Nel silenzio della notte si sentiva solo il ticchettio dell'orologio."
      }
    }
  },

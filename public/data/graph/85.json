  "concepts": {
    "c_0082": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'ottavo mese dell'anno, il più caldo e quello delle ferie.",
        "example": "Ad agosto il paese si svuota e i negozi chiudono."
      }
    },
    "c_0176": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle persone di un luogo o di una condizione.",
        "example": "La gente del paese si dà una mano nei momenti difficili."
      }
    },
    "c_0705": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il passaggio di qualcosa o qualcuno da un luogo a un altro.",
        "example": "Lo spostamento dei mobili ha richiesto tutto il pomeriggio."
      }
    }
  },

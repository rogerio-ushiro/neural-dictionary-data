{
  "shard": "e8",
  "concepts": {
    "c_0005": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sensazione di temperatura elevata che fa sudare e cercare frescura.",
        "example": "Con questo caldo non si riesce a dormire."
      }
    },
    "c_0070": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle linee che partono dal centro di un cerchio; anche un fascio di luce che si allarga da una sorgente.",
        "example": "Un raggio di sole filtrava dalle persiane."
      }
    },
    "c_0489": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stato d'animo lieto e vivace che si comunica agli altri.",
        "example": "La sua allegria contagiava tutta la tavolata."
      }
    },
    "c_0768": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi ha occupato una carica o un ruolo prima di un altro.",
        "example": "Il nuovo sindaco ha ereditato i debiti dell'antecessore."
      }
    },
    "c_0782": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Canto monotono e ripetitivo, come una filastrocca.",
        "example": "La maestra insegnava le tabelline con una cantilena."
      }
    }
  },

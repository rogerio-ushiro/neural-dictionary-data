    "c_0333": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Nome affettuoso e familiare con cui si chiama un gatto, soprattutto una femmina.",
        "example": "La micia si è accucciata in grembo al bambino."
      }
    },
    "c_0863": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle parti mobili del corpo che servono a muoversi o ad afferrare, come braccia e gambe.",
        "example": "L'atleta ha gli arti lunghi e muscolosi."
      }
    }
  },

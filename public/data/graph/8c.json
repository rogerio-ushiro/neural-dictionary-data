{
  "shard": "8c",
  "concepts": {
    "c_0139": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'aumento progressivo della velocità di un corpo in movimento.",
        "example": "Il treno prese velocità con una lenta accelerazione."
      }
    },
    "c_0434": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Organo interno in cui il cibo comincia a essere digerito; al figurato, la resistenza a situazioni sgradevoli.",
        "example": "Il cibo troppo pesante gli è rimasto sullo stomaco."
      }
    },
    "c_0441": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sostanza che, aggiunta all'impasto, lo fa gonfiare e diventare soffice.",
        "example": "Senza lievito il pane resta duro come una pietra."
      }
    },
    "c_0650": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fenditura che si apre in un terreno o in un muro secco.",
        "example": "Con la siccità nella terra si aprirono crepe larghe una mano."
      }
    },
    "c_0926": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sospensione di minute gocce d'acqua vicino al suolo che riduce la visibilità.",
        "example": "La nebbia era così fitta che non si vedeva la strada."
      }
    },
    "c_0993": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rumore secco e forte di qualcosa che esplode o si rompe di colpo.",
        "example": "Lo scoppio del petardo spaventò i passanti."
      }
    }
  },

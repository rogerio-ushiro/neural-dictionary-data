{
  "shard": "da",
  "concepts": {
    "c_0278": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi si unisce a un altro per un fine comune, contro un avversario condiviso.",
        "example": "In quella battaglia trovò un alleato inaspettato."
      }
    },
    "c_0461": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo frutto carnoso con semi all'interno, come il mirtillo o il ribes.",
        "example": "Raccolsero bacche di sottobosco per la marmellata."
      }
    },
    "c_0528": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Onda ampia e possente del mare aperto.",
        "example": "I flutti si abbattevano contro la scogliera."
      }
    },
    "c_0595": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bruciatura leggera della pelle causata da troppa esposizione al sole.",
        "example": "Dopo un'ora senza crema si era già preso una scottatura."
      }
    },
    "c_0630": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Oscurità fitta e completa (voce letteraria).",
        "example": "Le tenebre calarono sulla valle senza una stella."
      }
    },
    "c_0902": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Opera d'arte eretta in luogo pubblico per ricordare una persona o un fatto.",
        "example": "Al centro della piazza c'è un monumento ai caduti."
      }
    }
  },

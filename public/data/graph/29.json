      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Apertura del viso con cui si mangia e si emettono suoni; nell'animale, il muso con le fauci.",
        "example": "Il cane teneva il bastone in bocca."
      }
    },
    "c_0860": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il modo di camminare di una persona o di un animale, il suo passo.",
        "example": "Riconobbe l'amico da lontano per l'andatura ciondolante."
      }
    }
  },

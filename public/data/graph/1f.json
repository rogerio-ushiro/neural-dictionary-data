{
  "shard": "1f",
  "concepts": {
    "c_0138": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rapporto tra la distanza percorsa e il tempo impiegato; si usa anche per dire quanto in fretta accade qualcosa.",
        "example": "Sull'autostrada teneva una velocità costante."
      }
    },
    "c_0435": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Forma di pane tondeggiante e di media grandezza.",
        "example": "Ha tagliato la pagnotta a fette spesse per la bruschetta."
      }
    },
    "c_0440": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Miscuglio morbido di farina e acqua lavorato per fare pane, pasta o dolci.",
        "example": "L'impasto deve lievitare due ore in un luogo caldo."
      }
    },
    "c_0651": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Danno alla pelle o a un tessuto provocato dal fuoco o dal calore.",
        "example": "Si è procurato una bruciatura maneggiando la teglia."
      }
    },
    "c_0927": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Goccia molto piccola.",
        "example": "Una gocciolina di pioggia gli cadde sul naso."
      }
    },
    "c_0992": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ripetizione di un suono che torna all'orecchio dopo aver colpito una superficie lontana.",
        "example": "Nella grotta la sua voce tornava in un lungo eco."
      }
    }
  },

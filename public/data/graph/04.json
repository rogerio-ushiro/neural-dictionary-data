{
  "shard": "04",
  "concepts": {
    "c_0265": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lunga opera narrativa in prosa che racconta vicende inventate.",
        "example": "Ha finito il romanzo in due sere."
      }
    },
    "c_0359": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fiore dai petali morbidi e profumati e dal gambo spinoso, simbolo dell'amore.",
        "example": "Le regalò una rosa rossa per l'anniversario."
      }
    },
    "c_0535": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il numero di volte in cui un fatto si ripete in un certo tempo; per le onde, quante ne passano in un secondo.",
        "example": "Aumenta la frequenza degli allenamenti prima della gara."
      }
    },
    "c_0809": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il taglio dell'erba di un prato con la falce o la falciatrice.",
        "example": "Dopo la falciatura il prato profumava di fieno."
      }
    },
    "c_0896": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che appartiene alle piante; come sostantivo, un ortaggio.",
        "example": "Segue una dieta a base di vegetali freschi."
      }
    },
    "c_0913": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme dei prodotti della terra raccolti in una stagione.",
        "example": "Il raccolto di quest'anno è stato abbondante."
      }
    }
  },

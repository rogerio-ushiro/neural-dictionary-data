      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo frutto rosso a granuli, simile alla mora, che cresce sui cespugli di montagna.",
        "example": "Fecero una marmellata di lamponi a fine estate."
      }
    },
    "c_0596": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Del colore dell'oro; detto della pelle abbronzata dal sole.",
        "example": "Aveva la pelle dorata dopo un mese di mare."
      }
    },
    "c_0633": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il colore più scuro di tutti, quello dell'assenza di luce.",
        "example": "Indossava un abito nero per il funerale."
      }
    },
    "c_0901": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Recipiente ampio e incassato che contiene acqua, in bagno o nelle fontane.",

{
  "shard": "77",
  "concepts": {
    "c_0192": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Struttura verticale di mattoni o pietra che divide o recinta uno spazio.",
        "example": "Hanno tinteggiato il muro del giardino di bianco."
      }
    },
    "c_0471": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Freddo molto intenso che ghiaccia l'acqua e irrigidisce il terreno; in senso figurato, un improvviso raffreddarsi dei rapporti tra persone.",
        "example": "Il gelo notturno ha rovinato le piante sul balcone."
      }
    },
    "c_0585": {
      "revision": 3,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rombo cupo e prolungato che segue il lampo durante un temporale.",
        "example": "Il tuono fece sobbalzare il cane."
      }
    },
    "c_0606": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Slancio pieno di gioia con cui ci si getta in un'impresa.",
        "example": "Accolse la proposta con entusiasmo."
      }
    },
    "c_0974": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualità di ciò che non si piega né si adatta, per materiale o per carattere.",
        "example": "La rigidità dell'acciaio lo rende adatto alle travi."
      }
    },
    "c_1018": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Catturare pesci con la rete, la lenza o le mani.",
        "example": "Andava a pescare sul molo ogni domenica all'alba."
      }
    }
  },

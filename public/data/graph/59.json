  "concepts": {
    "c_0068": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Corpo celeste luminoso, in particolare il sole.",
        "example": "Al calar della notte comparve il primo astro."
      }
    },
    "c_0114": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il percorso che si compie per andare da un luogo a un altro, di solito breve e abituale.",
        "example": "Il tragitto da casa all'ufficio dura venti minuti."
      }
    },
    "c_0770": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi apre la strada a chi verrà dopo, anticipando idee o scoperte.",
        "example": "È considerato un precursore della medicina moderna."
      }
    }
  },

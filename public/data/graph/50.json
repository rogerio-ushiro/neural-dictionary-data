{
  "shard": "50",
  "concepts": {
    "c_0078": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Assenza di luce; al figurato, ignoranza o mistero in cui non si vede chiaro.",
        "example": "Nell'oscurità della cantina cercò a tentoni l'interruttore."
      }
    },
    "c_0104": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Attività piacevole che serve a distendersi e a recuperare le forze dopo il lavoro.",
        "example": "Il cortile della scuola è riservato alla ricreazione."
      }
    },
    "c_0481": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'atto di festeggiare pubblicamente un avvenimento importante.",
        "example": "La celebrazione dell'anniversario si tenne in municipio."
      }
    },
    "c_0715": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Studio delle forze che mettono in moto i corpi; al figurato, il modo in cui si sviluppano e si concatenano i fatti di una vicenda.",
        "example": "Gli storici analizzano la dinamica degli avvenimenti."
      }
    },
    "c_0760": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'aspetto esteriore con cui qualcuno o qualcosa si presenta, spesso ingannevole.",
        "example": "Sotto quella sembianza mite si nascondeva un carattere duro."
      }
    }
  },

  "concepts": {
    "c_0457": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo frutto rosso e tondo con il nocciolo, che matura a coppie su un lungo picciolo.",
        "example": "I bambini si appesero le ciliegie alle orecchie."
      }
    },
    "c_0624": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il tramontare del sole; per estensione, la fine di un periodo (voce letteraria).",
        "example": "All'occaso il cielo si accese di arancio."
      }
    },
    "c_0743": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il punto da cui qualcosa comincia o proviene; anche la famiglia o il luogo di provenienza.",
        "example": "Le sue origini sono in un piccolo paese del sud."
      }
    },
    "c_0981": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualità di ciò che è pulito e privo di ogni elemento estraneo; anche l'onestà d'animo di chi non ha secondi fini.",
        "example": "Apprezzava la purezza dell'aria di montagna."
      }
    }
  },

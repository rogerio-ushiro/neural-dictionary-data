{
  "shard": "c2",
  "concepts": {
    "c_0102": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Attività piacevole con cui ci si riposa la mente distraendosi dagli impegni.",
        "example": "Nei pomeriggi liberi si dedica allo svago della lettura."
      }
    },
    "c_0487": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Festa chiassosa e sfrenata, con canti e abbondanti bevute.",
        "example": "Fecero baldoria fino all'alba per la vittoria."
      }
    },
    "c_0713": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Leggero e involontario scuotersi del corpo, per freddo, paura o emozione.",
        "example": "Un tremore alle mani lo tradiva mentre firmava."
      }
    },
    "c_0766": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il padre del nonno o della nonna.",
        "example": "Il bisnonno visse fino a cent'anni."
      }
    }
  },

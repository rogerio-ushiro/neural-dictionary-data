{
  "shard": "6b",
  "concepts": {
    "c_0134": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Prospetto delle ore di partenza e di arrivo dei mezzi di trasporto.",
        "example": "Ha controllato l'orario dei treni sul cellulare."
      }
    },
    "c_0141": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Contenitore rigido e capiente, spesso di forma bombata, usato un tempo per i lunghi viaggi.",
        "example": "Nel solaio c'era un vecchio baule pieno di lettere."
      }
    },
    "c_0439": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bastoncino di pane secco e croccante che si serve come antipasto.",
        "example": "Sgranocchiava grissini aspettando il primo piatto."
      }
    },
    "c_0750": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme dei discendenti di una persona o di una coppia.",
        "example": "Lasciò la fattoria alla sua numerosa progenie."
      }
    }
  },

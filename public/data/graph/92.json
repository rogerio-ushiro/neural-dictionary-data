{
  "shard": "92",
  "concepts": {
    "c_0326": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme dei sottili filamenti che coprono la pelle di molti animali e proteggono dal freddo.",
        "example": "Il gatto perde il pelo in primavera."
      }
    },
    "c_0353": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Prodotto della pianta che contiene i semi e di solito si mangia; al figurato, il risultato di uno sforzo.",
        "example": "Ha colto un frutto maturo direttamente dal ramo."
      }
    },
    "c_0803": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Terreno erboso dove il bestiame va a brucare.",
        "example": "Le mucche salgono al pascolo alto in giugno."
      }
    },
    "c_0876": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che sta o si svolge dentro un edificio o un confine.",
        "example": "Passarono il pomeriggio in un cortile interno al riparo dal vento."
      }
    },
    "c_0919": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il guadagno che si trae da un'attività o da una vendita.",
        "example": "Il ricavo della lotteria andrà in beneficenza."
      }
    },
    "c_1040": {
      "revision": 2,
      "region_id": "r_relazioni_sociali",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi sta compiendo un viaggio, di solito servendosi di un mezzo pubblico.",
        "example": "I viaggiatori assonnati aspettavano la coincidenza sulla banchina."
      }
    }
  },

{
  "shard": "c9",
  "concepts": {
    "c_0158": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte più antica e importante di una città o di un paese; anche il punto attorno a cui si organizza qualcosa.",
        "example": "Ha aperto un negozio nel centro storico."
      }
    },
    "c_0297": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Estensione di terreno coperta di alberi fitti, meno vasta di una foresta.",
        "example": "Nel bosco si sentiva solo il fruscio delle foglie."
      }
    },
    "c_0420": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cibo cucinato e pronto da servire in tavola.",
        "example": "Ha preparato una pietanza di pesce per gli ospiti."
      }
    },
    "c_0644": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Mancanza d'acqua che rende un terreno sterile; al figurato, povertà di sentimenti o di idee.",
        "example": "Nell'aridità del deserto non cresce nulla."
      }
    },
    "c_0936": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampia curva che un fiume disegna serpeggiando nella pianura.",
        "example": "Il sentiero seguiva i meandri del fiume."
      }
    },
    "c_0943": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il passaggio di un liquido allo stato di vapore per effetto del calore.",
        "example": "L'evaporazione dell'acqua del mare forma le nuvole."
      }
    }
  },

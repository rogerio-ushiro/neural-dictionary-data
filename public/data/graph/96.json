    "c_0331": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Impulso naturale che spinge gli animali ad agire in un certo modo senza averlo imparato.",
        "example": "Per istinto la gatta portò i cuccioli al sicuro."
      }
    },
    "c_0861": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La capacità degli animali di spostarsi da un luogo a un altro con le proprie forze.",
        "example": "Nei pesci la locomozione avviene grazie alle pinne."
      }
    }
  },

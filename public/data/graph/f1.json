  "concepts": {
    "c_0060": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il colore più scuro che la pelle assume dopo essere stata a lungo al sole.",
        "example": "È tornato dalle vacanze con un'abbronzatura invidiabile."
      }
    },
    "c_0778": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il primato assoluto su tutti gli altri.",
        "example": "Si contendevano la supremazia commerciale sulla regione."
      }
    },
    "c_0796": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bosco fitto e intricato, difficile da attraversare (voce letteraria).",
        "example": "Si inoltrarono nella selva seguendo un sentiero appena visibile."
      }
    }
  },

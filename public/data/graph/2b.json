{
  "shard": "2b",
  "concepts": {
    "c_0196": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Le persone legate dallo stesso sangue.",
        "example": "Solo i consanguinei più stretti furono ammessi alla lettura del testamento."
      }
    },
    "c_0475": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Preparazione dolce, densa e morbida, a base di latte, uova o frutta.",
        "example": "Ha spalmato la crema di nocciole sul pane."
      }
    },
    "c_0581": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vortice di vento che solleva polvere e detriti girando su se stesso.",
        "example": "Un turbine di foglie si alzò in mezzo alla strada."
      }
    },
    "c_0602": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Slancio appassionato e intenso con cui si fa o si desidera qualcosa.",
        "example": "Difese la sua tesi con ardore."
      }
    },
    "c_0970": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il passaggio di un liquido allo stato solido per effetto del freddo.",
        "example": "Il congelamento dell'acqua nelle crepe spacca la roccia."
      }
    }
  },

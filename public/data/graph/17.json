      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che rende visibili le cose, emesso dal sole, dal fuoco o da una lampada; al figurato, la comprensione che chiarisce un problema.",
        "example": "Accese la luce perché era ormai buio."
      }
    },
    "c_0790": {

  "concepts": {
    "c_0061": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Persona incaricata di vigilare i bagnanti e soccorrere chi è in difficoltà in acqua.",
        "example": "Il bagnino fischiò ai ragazzi che si erano spinti troppo al largo."
      }
    },
    "c_0779": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Autorità e importanza che si dà alle parole o alle scelte di qualcuno.",
        "example": "Il suo parere ha molto peso nelle riunioni."
      }
    },
    "c_0797": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Materiale duro ricavato dal tronco degli alberi, usato per costruire e ardere.",
        "example": "Il tavolo è di legno massiccio di noce."
      }
    }
  },

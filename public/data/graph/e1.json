{
  "shard": "e1",
  "concepts": {
    "c_0312": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Leva su cui si spinge col piede per mettere in moto una bicicletta o azionare un comando.",
        "example": "Spingeva sui pedali con tutte le forze in salita."
      }
    },
    "c_0385": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Colore spento e uniforme tra il bianco e il nero; al figurato, un'atmosfera monotona e triste.",
        "example": "Il grigiore del cielo durò per giorni."
      }
    },
    "c_0842": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che nasce da un impulso naturale e non da riflessione.",
        "example": "Ebbe una reazione istintiva di paura."
      }
    },
    "c_1034": {
      "revision": 2,
      "region_id": "r_oggetti",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Strumento che misura la temperatura dell'aria o del corpo e la indica su una scala graduata.",
        "example": "Ha tenuto il termometro sotto il braccio per qualche minuto."
      }
    }
  },

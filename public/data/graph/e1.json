      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Colore spento e uniforme tra il bianco e il nero; al figurato, un'atmosfera monotona e triste.",
        "example": "Il grigiore del cielo durò per giorni."
      }
    },
    "c_0842": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che nasce da un impulso naturale e non da riflessione.",

{
  "shard": "32",
  "concepts": {
    "c_0209": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino piccolo (voce affettuosa).",
        "example": "Il bimbo si è addormentato in braccio alla madre."
      }
    },
    "c_0300": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme di tutto ciò che esiste senza l'intervento dell'uomo, dalle piante ai monti al clima; anche il carattere di fondo di una persona.",
        "example": "Ama passare i fine settimana immerso nella natura."
      }
    },
    "c_0559": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pietra di media grandezza, staccata dalla roccia.",
        "example": "Inciampò in un sasso e per poco non cadde."
      }
    },
    "c_0850": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che produce o riguarda il latte.",
        "example": "Le ghiandole lattifere si sviluppano durante l'allattamento."
      }
    }
  },

    "c_0161": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle persone che vivono in un luogo.",
        "example": "La popolazione del paese è dimezzata in vent'anni."
      }
    },
    "c_0288": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Passatempo allegro e spensierato, di solito in compagnia.",
        "example": "Per loro il sollazzo più grande era ballare fino a notte."
      }
    },
    "c_0419": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi sostanza che, mangiata, nutre il corpo.",
        "example": "Il latte è un alimento completo per il neonato."
      }
    },
    "c_0675": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Allegria improvvisa che fa ridere di gusto.",
        "example": "La sua battuta scatenò l'ilarità della sala."
      }
    },
    "c_0730": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampia strada cittadina, spesso alberata su entrambi i lati.",
        "example": "Passeggiarono lungo il viale fino ai giardini."
      }
    }

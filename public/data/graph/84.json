      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Corpo celeste che brilla di luce propria nel cielo notturno; al figurato, una persona famosa e ammirata.",
        "example": "Quella sera si vedeva una stella cadente dietro l'altra."
      }
    },
    "c_0791": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Membro della stessa confraternita o compagno di fede.",
        "example": "I confratelli si occupano dell'assistenza agli anziani."
      }
    }
  },

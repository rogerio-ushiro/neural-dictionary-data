{
  "shard": "93",
  "concepts": {
    "c_0242": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Persona molto avanti negli anni.",
        "example": "L'anziano del paese ricorda ancora la guerra."
      }
    },
    "c_0512": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Assenza totale o quasi di luce.",
        "example": "Al buio si muoveva in casa senza sbattere da nessuna parte."
      }
    },
    "c_0589": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Distesa di sabbia lungo la riva del mare.",
        "example": "L'arenile si estendeva per chilometri deserto."
      }
    },
    "c_0978": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'atto di far entrare e uscire aria dai polmoni per vivere; anche un attimo di sollievo.",
        "example": "Trattenne il respiro mentre si immergeva."
      }
    },
    "c_1014": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Asta di legno con una pala a un capo, che si immerge nell'acqua per spingere avanti la barca.",
        "example": "Tirò dentro i remi e lasciò scivolare la barca."
      }
    }
  },

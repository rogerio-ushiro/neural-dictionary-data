{
  "shard": "0e",
  "concepts": {
    "c_0007": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il fatto di allontanarsi dal luogo dove si abita per raggiungerne un altro lontano, per svago, lavoro o necessità; in senso figurato, un percorso di crescita interiore.",
        "example": "Hanno passato mesi a organizzare il viaggio in Giappone."
      }
    },
    "c_0072": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Capacità di compiere un lavoro o di mettere in moto qualcosa; al figurato, la vitalità di una persona.",
        "example": "I pannelli trasformano la luce del sole in energia."
      }
    },
    "c_0780": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fatto avvenuto in passato a cui ci si richiama per giustificare o prevedere qualcosa.",
        "example": "Non c'è un precedente simile nella storia del club."
      }
    }
  },

{
  "shard": "4b",
  "concepts": {
    "c_0260": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che qualcuno crea con l'ingegno o il lavoro, in arte o in altro campo.",
        "example": "Quel dipinto è la sua opera più famosa."
      }
    },
    "c_0329": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'azione di difendere qualcuno o qualcosa da un pericolo o da un danno.",
        "example": "Il cane offre una buona protezione alla fattoria."
      }
    },
    "c_0530": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di onde che si susseguono rapide; al figurato, un'ondata di caldo, di gente o di emozioni.",
        "example": "Un'ondata di freddo ha investito tutta la regione."
      }
    },
    "c_0879": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che riguarda la città e la vita cittadina.",
        "example": "Il trasporto urbano è gratuito per gli anziani."
      }
    },
    "c_0893": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle formazioni leggere che ricoprono il corpo degli uccelli e servono al volo e al caldo.",
        "example": "Trovò una piuma bianca sul davanzale."
      }
    },
    "c_0916": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di acini o di frutti attaccati a un unico stelo.",
        "example": "Staccò un grappolo d'uva dalla pergola."
      }
    }
  },

    "c_0213": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino piccolo e vivace (voce familiare e scherzosa).",
        "example": "Quel marmocchio non sta fermo un attimo."
      }
    },
    "c_0543": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il bordo estremo di una superficie, il punto in cui finisce.",
        "example": "Riempì il bicchiere fino all'orlo."
      }
    },
    "c_0882": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sottile e rado strato di peli, soprattutto sul viso o su frutti come la pesca.",
        "example": "Sulle guance del ragazzo spuntava una prima peluria."
      }
    }

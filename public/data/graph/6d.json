  "shard": "6d",
  "concepts": {
    "c_0279": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi lavora insieme a un altro nello stesso ufficio o mestiere.",
        "example": "Ha invitato a cena due colleghi del reparto."
      }
    },
    "c_0460": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grosso frutto estivo dalla polpa dolce e profumata, giallo o arancione dentro.",
        "example": "Un melone ben maturo si riconosce dal profumo."
      }
    },
    "c_0529": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il formarsi di onde sulla superficie di un liquido.",
        "example": "Un sasso nello stagno provocò una lenta undulazione."
      }
    },
    "c_0594": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il tempo trascorso al sole o all'aria; anche il modo in cui un edificio è rivolto rispetto al sole.",
        "example": "La casa gode di un'ottima esposizione a mezzogiorno."
      }
    },
    "c_0631": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grado di oscurità, il buio più o meno fitto.",
        "example": "Con la scurezza del temporale dovettero accendere le luci a mezzogiorno."
      }
    },
    "c_0903": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Zampillo d'acqua o di altro liquido che esce con forza da un'apertura.",
        "example": "Un getto d'acqua schizzò via dal tubo rotto."
      }
    }
  },

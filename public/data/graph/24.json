  "concepts": {
    "c_0131": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Coppia di rotaie parallele su cui corrono i treni.",
        "example": "È vietato attraversare il binario fuori dai passaggi."
      }
    },
    "c_0144": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sacca che si porta sulle spalle con due bretelle, usata per tenere le mani libere mentre si cammina o si va a scuola.",
        "example": "Ha infilato il quaderno nello zaino ed è uscito di corsa."
      }
    },
    "c_0449": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pianta erbacea coltivata per i suoi semi commestibili, come grano, mais e riso.",
        "example": "A colazione mangia un cereale con il latte."
      }
    },
    "c_0658": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'allentamento della tensione muscolare e mentale che dà riposo.",
        "example": "Qualche minuto di rilassamento prima di dormire."
      }
    },
    "c_0755": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi essere vivente, animale o vegetale, capace di nascere, nutrirsi e riprodursi.",
        "example": "Anche il più piccolo organismo ha un ruolo nell'ecosistema."
      }
    }
  },

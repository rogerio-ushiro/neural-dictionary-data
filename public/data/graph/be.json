{
  "shard": "be",
  "concepts": {
    "c_0195": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Le persone legate da vincoli di sangue o di matrimonio.",
        "example": "A Natale si riuniscono tutti i parenti."
      }
    },
    "c_0249": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Istituto che ospita gli studenti offrendo vitto, alloggio e sorveglianza.",
        "example": "Da ragazzo studiò in un collegio di montagna."
      }
    },
    "c_0476": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Recipiente basso e largo in cui si serve il gelato o la macedonia.",
        "example": "Ordinò una coppa con tre gusti e panna."
      }
    },
    "c_0519": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La luce rossastra che colora il cielo poco prima che sorga il sole.",
        "example": "L'aurora tingeva di rosa le cime innevate."
      }
    },
    "c_0582": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tempesta di mare violenta e prolungata.",
        "example": "La procella durò tutta la notte scuotendo il faro."
      }
    },
    "c_0601": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'età giovanile, il tempo della vita tra l'infanzia e la maturità.",
        "example": "Nella sua gioventù aveva girato mezzo mondo."
      }
    },
    "c_0973": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Freddo intenso e severo; anche il rispetto scrupoloso di una regola.",
        "example": "Applicò il regolamento con estremo rigore."
      }
    }
  },

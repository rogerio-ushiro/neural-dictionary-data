      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno degli ambienti chiusi in cui è divisa una casa.",
        "example": "La stanza dei bambini dà sul cortile."
      }
    },
    "c_0472": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Dolce che chiude il pasto, spesso freddo o al cucchiaio.",
        "example": "Come dessert hanno servito una panna cotta."
      }
    },
    "c_0586": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Massa di vapore acqueo sospesa in cielo, che porta ombra e a volte pioggia.",
        "example": "Una nube nera avanzava minacciosa da ovest."
      }
    },
    "c_0605": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sentimento fortissimo che travolge la ragione, in amore o in un'attività.",
        "example": "Mette in ogni partita una passione contagiosa."
      }
    },
    "c_0977": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Severità di modi e di vita, priva di ogni comodità o indulgenza.",
        "example": "Viveva con un'austerità quasi monastica."
      }
    }

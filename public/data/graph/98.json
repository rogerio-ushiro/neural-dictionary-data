{
  "shard": "98",
  "concepts": {
    "c_0197": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Famiglia nobile considerata nel suo insieme di antenati e discendenti.",
        "example": "La casata possedeva metà delle terre della valle."
      }
    },
    "c_0474": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Di sapore zuccherino, gradevole al palato; al figurato, mite e affettuoso nei modi.",
        "example": "Ha un carattere dolce e paziente."
      }
    },
    "c_0580": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tempesta rotante di enorme forza distruttiva, con venti che superano i cento chilometri orari.",
        "example": "L'uragano ha scoperchiato decine di case sulla costa."
      }
    },
    "c_0603": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Calore lieve e piacevole che riscalda senza bruciare.",
        "example": "Il tepore del sole di marzo invitava a uscire."
      }
    },
    "c_0971": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sottile strato di ghiaccio che si forma di notte su superfici esposte al freddo.",
        "example": "Il parabrezza era coperto di brina al mattino."
      }
    }
  },

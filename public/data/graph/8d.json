{
  "shard": "8d",
  "concepts": {
    "c_0051": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il condurre una nave o un aereo lungo una rotta stabilita; indica anche lo spostarsi tra le pagine di un sito.",
        "example": "La navigazione fu resa difficile dalla nebbia."
      }
    },
    "c_0125": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Partenza in massa di molte persone da un luogo, per sfuggire a un pericolo o cercare condizioni migliori.",
        "example": "Ad agosto c'è l'esodo delle città verso il mare."
      }
    },
    "c_0749": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Categoria che raccoglie cose o esseri con caratteri comuni.",
        "example": "Il romanzo giallo è un genere molto amato."
      }
    }
  },

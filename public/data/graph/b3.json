{
  "shard": "b3",
  "concepts": {
    "c_0268": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il modo di scrivere che segue l'ordine naturale del discorso, senza versi.",
        "example": "Ha una prosa limpida e senza fronzoli."
      }
    },
    "c_0321": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Animale che partorisce piccoli già formati e li nutre col proprio latte, come il cane, la balena e l'uomo.",
        "example": "La balena è il mammifero più grande del pianeta."
      }
    },
    "c_0354": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Zona più scura che un corpo proietta parando la luce; al figurato, un vago sospetto o un lato oscuro.",
        "example": "A mezzogiorno l'ombra dell'albero era ridotta a un cerchio."
      }
    },
    "c_0538": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La fascia di terra che si stende lungo la riva del mare, con i suoi centri abitati.",
        "example": "Il litorale è protetto da una lunga fila di dune."
      }
    },
    "c_0804": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Terreno coltivato o lasciato a prato, fuori dall'abitato; anche lo spazio delimitato per uno sport.",
        "example": "I campi di grano arrivavano fino all'orizzonte."
      }
    },
    "c_0871": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che riguarda la casa e le sue faccende; anche chi si occupa della famiglia senza un lavoro fuori.",
        "example": "Le pareva un lavoro casalingo poco gratificante."
      }
    },
    "c_1047": {
      "revision": 2,
      "region_id": "r_oggetti",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Capo che si indossa per coprire il corpo, spesso scelto secondo l'occasione o il gusto di chi lo porta.",
        "example": "Per il colloquio ha tirato fuori il vestito buono."
      }
    }
  },

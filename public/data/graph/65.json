{
  "shard": "65",
  "concepts": {
    "c_0169": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Comunità di persone con la stessa lingua, storia e territorio, organizzata in Stato.",
        "example": "L'inno viene cantato prima delle partite della nazione."
      }
    },
    "c_0235": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Antenato, in particolare il nonno o un ascendente lontano (voce elevata).",
        "example": "Gli avi riposano tutti nello stesso cimitero di campagna."
      }
    },
    "c_0280": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ogni altra persona verso cui si hanno doveri di rispetto e solidarietà.",
        "example": "Ama il prossimo come te stesso."
      }
    },
    "c_0411": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampia conca del terreno in cui si raccolgono le acque di un fiume o di un lago.",
        "example": "Le piogge riempiono il bacino artificiale della diga."
      }
    },
    "c_0565": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccola isola.",
        "example": "Al centro del lago spunta un isolotto con una cappella."
      }
    },
    "c_0697": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle persone che accompagnano e servono un personaggio importante.",
        "example": "Il ministro arrivò con tutto il suo seguito."
      }
    },
    "c_0738": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il primo stabilirsi di un gruppo di persone in un luogo per abitarvi.",
        "example": "Gli scavi hanno riportato alla luce un insediamento preistorico."
      }
    },
    "c_0954": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il modo in cui una situazione si sviluppa nel tempo, se in meglio o in peggio.",
        "example": "L'andamento delle vendite è migliorato in autunno."
      }
    }
  },

{
  "shard": "f6",
  "concepts": {
    "c_0274": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Persona a cui si confidano i propri segreti e pensieri.",
        "example": "È l'unica confidente delle sue preoccupazioni."
      }
    },
    "c_0340": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccola porzione di terreno delimitata in un giardino, dove si coltivano fiori.",
        "example": "Ha piantato tulipani lungo l'aiuola del vialetto."
      }
    },
    "c_0524": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il momento centrale del giorno, quando il sole è più alto.",
        "example": "A mezzogiorno le campane suonano l'Angelus."
      }
    },
    "c_0599": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Colore scuro tra il rosso e il nero, come quello della terra o della pelle abbronzata.",
        "example": "Ha scelto un divano marrone per non far vedere le macchie."
      }
    },
    "c_0810": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Superficie morbida e uniforme che ricopre un pavimento o il terreno.",
        "example": "Un tappeto di aghi di pino attutiva i passi nel bosco."
      }
    }
  },

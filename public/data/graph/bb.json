{
  "shard": "bb",
  "concepts": {
    "c_0048": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Terra circondata da acqua per ogni lato.",
        "example": "Sull'isola si arriva solo con il traghetto."
      }
    },
    "c_0310": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Barra ricurva della bicicletta o della moto che si impugna per guidare e sterzare.",
        "example": "Stringeva il manubrio nelle discese ripide."
      }
    },
    "c_0387": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Miscuglio gassoso che si respira e circonda la Terra; indica anche un breve motivo musicale e l'aspetto che una persona mostra di sé.",
        "example": "Aprì la finestra per far entrare un po' d'aria."
      }
    },
    "c_0840": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Animale dalla pelle coperta di squame che striscia o cammina su zampe corte, come il serpente e la lucertola.",
        "example": "Sotto il sasso si nascondeva un piccolo rettile."
      }
    },
    "c_1036": {
      "revision": 2,
      "region_id": "r_movimento",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tratto di strada che sale, o l'atto di percorrerlo andando verso l'alto.",
        "example": "L'ultima salita prima del passo mise alla prova le gambe."
      }
    }
  },

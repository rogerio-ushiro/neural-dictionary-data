{
  "shard": "36",
  "concepts": {
    "c_0159": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fascia di terreno preparata perché ci passino persone e veicoli tra due luoghi; al figurato, la via da seguire per raggiungere uno scopo.",
        "example": "La strada per il paese è stretta e piena di curve."
      }
    },
    "c_0296": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Scherno pubblico che espone qualcuno al ridicolo.",
        "example": "Fu esposto al ludibrio dei compagni per quell'errore."
      }
    },
    "c_0421": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cibo preparato e servito a tavola.",
        "example": "Sulla mensa fumavano vivande di ogni genere."
      }
    },
    "c_0645": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lunga assenza di pioggia che secca i campi e prosciuga i corsi d'acqua.",
        "example": "La siccità di quell'estate rovinò tutto il raccolto."
      }
    },
    "c_0937": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il letto scavato dall'acqua in cui scorre un fiume.",
        "example": "In estate l'alveo del torrente resta quasi asciutto."
      }
    },
    "c_0942": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rendere leggermente umido.",
        "example": "Inumidì un panno per pulire lo schermo."
      }
    }
  },

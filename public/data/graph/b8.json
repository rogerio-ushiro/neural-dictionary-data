{
  "shard": "b8",
  "concepts": {
    "c_0261": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle parole scritte che compongono un'opera; anche il contenuto rispetto alla forma.",
        "example": "Ha corretto il testo prima di consegnarlo all'editore."
      }
    },
    "c_0328": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Legame di affetto e fiducia tra persone che si vogliono bene senza legami di parentela.",
        "example": "La loro amicizia dura da quando erano bambini."
      }
    },
    "c_0531": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grossa e minacciosa onda del mare in burrasca.",
        "example": "I marosi facevano beccheggiare paurosamente il peschereccio."
      }
    },
    "c_0878": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ambiente chiuso di un edificio adibito a un uso; anche un esercizio pubblico dove si beve e si balla.",
        "example": "Hanno affittato il locale al pianterreno per aprirci un bar."
      }
    },
    "c_0892": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Filamento sottile di materiale animale, vegetale o artificiale, di cui sono fatti tessuti e corde.",
        "example": "La corda è intrecciata con fibra vegetale."
      }
    },
    "c_0917": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che si ottiene alla fine di un'azione o di un calcolo.",
        "example": "Il risultato dell'esame è arrivato per posta."
      }
    }
  },

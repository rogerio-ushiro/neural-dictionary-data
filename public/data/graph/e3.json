{
  "shard": "e3",
  "concepts": {
    "c_0079": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno dei quattro periodi in cui si divide l'anno secondo il clima.",
        "example": "L'autunno è la sua stagione preferita."
      }
    },
    "c_0105": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Breve interruzione di un'attività per riposarsi o cambiare occupazione.",
        "example": "Facciamo una pausa di dieci minuti e poi riprendiamo."
      }
    },
    "c_0480": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Alimento dolce e scuro ricavato dai semi del cacao, base di dolci e bevande.",
        "example": "Sciolse un quadretto di cioccolato fondente nel latte."
      }
    },
    "c_0714": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lo scorrere continuo e ordinato di un liquido, un gas o anche di persone e informazioni.",
        "example": "Un flusso ininterrotto di turisti attraversava la piazza."
      }
    },
    "c_0761": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'aspetto esteriore di una persona vista da lontano o nell'ombra.",
        "example": "Nella nebbia si intravedeva una figura ferma sul ponte."
      }
    }
  },

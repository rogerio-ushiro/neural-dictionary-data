{
  "shard": "60",
  "concepts": {
    "c_0232": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi ha in cura la conservazione di un bene o di un luogo.",
        "example": "È il custode del faro da vent'anni."
      }
    },
    "c_0287": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Attività leggera con cui si occupa piacevolmente il tempo libero.",
        "example": "Le parole crociate sono il suo passatempo del mattino."
      }
    },
    "c_0416": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rientranza della costa, più piccola di un golfo, dove l'acqua è calma e riparata.",
        "example": "Ancorarono la barca in una baia tranquilla."
      }
    },
    "c_0562": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Guglia rocciosa isolata e appuntita.",
        "example": "Gli scalatori raggiunsero la cima del pinnacolo all'alba."
      }
    },
    "c_0690": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Condizione di chi non può essere colpito da una legge, una malattia o un pericolo.",
        "example": "I diplomatici godono dell'immunità giudiziaria."
      }
    },
    "c_0953": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle facce o dei punti di vista sotto cui si può considerare una cosa.",
        "example": "La proposta va valutata sotto l'aspetto economico."
      }
    }
  },

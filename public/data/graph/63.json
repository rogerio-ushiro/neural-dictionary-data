{
  "shard": "63",
  "concepts": {
    "c_0277": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Compagno affiatato come lo è un membro della stessa famiglia; anche il membro di un ordine religioso.",
        "example": "Al reparto lo trattavano come un fratello."
      }
    },
    "c_0343": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Costruzione con vasche e getti d'acqua, posta in piazze e giardini per ornamento o per attingere acqua.",
        "example": "I bambini lanciavano monetine nella fontana."
      }
    },
    "c_0527": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Luce viva e intensa che si irradia da qualcosa; al figurato, il fasto o la magnificenza.",
        "example": "Lo splendore del sole sulla neve costringeva a socchiudere gli occhi."
      }
    },
    "c_0813": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vasta pianura coperta d'erba, senza alberi.",
        "example": "Nella prateria pascolavano mandrie di bisonti."
      }
    }
  },

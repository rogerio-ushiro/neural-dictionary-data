{
  "shard": "ad",
  "concepts": {
    "c_0154": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'edificio dove ha sede il governo di una città e si sbrigano le pratiche dei cittadini.",
        "example": "Si sposarono in municipio con due testimoni."
      }
    },
    "c_0648": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il perdere freschezza e vigore, come una pianta senz'acqua.",
        "example": "L'avvizzimento delle foglie annunciava la fine dell'estate."
      }
    },
    "c_0723": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Oggetto di forma circolare senza principio né fine, spesso portato al dito.",
        "example": "Le è caduto l'anello nello scarico del lavandino."
      }
    }
  },

      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di gare tra più concorrenti per assegnare un titolo.",
        "example": "Ha vinto il torneo di scacchi della scuola."
      }
    },
    "c_0425": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno dei piatti che compongono un pasto, servito nel suo turno.",
        "example": "Come portata principale hanno servito arrosto e patate."
      }
    },
    "c_0641": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Caldo estremo e bruciante, tipico dei deserti e delle ore di punta d'estate.",

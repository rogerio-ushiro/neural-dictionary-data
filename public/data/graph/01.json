{
  "shard": "01",
  "concepts": {
    "c_0187": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'atto e il modo di costruire un edificio o un'opera; anche l'opera stessa.",
        "example": "La costruzione del ponte durò tre anni."
      }
    },
    "c_0402": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rilievo del terreno più basso e dai fianchi meno ripidi di una montagna, spesso coltivato o abitato in cima.",
        "example": "La chiesa sorge in cima al colle, fuori dal paese."
      }
    },
    "c_0495": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Spuntino leggero che si fa nel pomeriggio, soprattutto dai bambini.",
        "example": "Per merenda si prese pane e marmellata."
      }
    },
    "c_0613": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Luce viva e improvvisa che risalta nel buio.",
        "example": "Nel temporale un bagliore illuminò tutta la stanza."
      }
    },
    "c_0666": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il sostituire ciò che è vecchio o consumato con qualcosa di nuovo.",
        "example": "Il palazzo ha bisogno di un profondo rinnovamento."
      }
    },
    "c_0688": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il consenso a fare qualcosa dato da chi ne ha l'autorità.",
        "example": "Ha chiesto il permesso di uscire prima."
      }
    },
    "c_1009": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il guscio esterno di una nave, la struttura che galleggia sull'acqua.",
        "example": "Lo scafo aveva bisogno di una raschiata e di nuova vernice."
      }
    }
  },

      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il gruppo ristretto di parenti e amici intimi.",
        "example": "Nella sua cerchia si conoscono da sempre."
      }
    },
    "c_0557": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Precipizio stretto e profondo tra le rocce.",
        "example": "Un ponte di corda attraversava il burrone."
      }
    },
    "c_1024": {
      "revision": 2,
      "region_id": "r_relazioni_sociali",
      "status_fronteira": "needs_expansion",
      "definition": {

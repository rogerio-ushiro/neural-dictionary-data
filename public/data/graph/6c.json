{
  "shard": "6c",
  "concepts": {
    "c_0324": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno degli arti su cui un animale si regge e cammina, spesso munito di unghie o artigli.",
        "example": "Il gatto si è fatto male a una zampa saltando dal muro."
      }
    },
    "c_0351": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il tronco della pianta, la parte legnosa che sale dal terreno e regge la chioma.",
        "example": "Il fusto del faggio era liscio e grigio."
      }
    },
    "c_0801": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pianta bassa e ramificata fin dalla base, più piccola di un albero.",
        "example": "Dietro il muretto era cresciuto un cespuglio di rovi."
      }
    },
    "c_0874": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che riguarda la convivenza ordinata tra i cittadini; anche cortese ed educato.",
        "example": "Ha modi civili anche quando discute."
      }
    },
    "c_1042": {
      "revision": 2,
      "region_id": "r_oggetti",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Materiale sottile ricavato dalla cellulosa, su cui si scrive, si stampa o si avvolgono le cose.",
        "example": "Avvolse il regalo in un foglio di carta colorata."
      }
    }
  },

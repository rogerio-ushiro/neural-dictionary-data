  "concepts": {
    "c_0027": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Parte della pianta, spesso colorata e profumata, da cui si sviluppa il frutto; si regala e si usa per ornare.",
        "example": "Ha colto un fiore di campo e se l'è messo tra i capelli."
      }
    },
    "c_0092": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lingua di gas incandescente che si alza da qualcosa che brucia.",
        "example": "La fiamma della candela tremolava alla corrente."
      }
    }
  },

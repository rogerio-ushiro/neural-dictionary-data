{
  "shard": "3b",
  "concepts": {
    "c_0152": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cartellino applicato a un oggetto per indicarne contenuto, prezzo o proprietario.",
        "example": "Sull'etichetta della valigia c'era l'indirizzo di casa."
      }
    },
    "c_0725": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ruota dentata che ingrana con un'altra per trasmettere il movimento in un meccanismo.",
        "example": "Un ingranaggio consumato faceva slittare la trasmissione."
      }
    },
    "c_0949": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La più piccola parte di una sostanza che ne conserva le proprietà.",
        "example": "Ogni atomo è formato da un nucleo e da elettroni."
      }
    }
  },

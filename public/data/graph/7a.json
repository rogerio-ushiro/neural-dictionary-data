      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino o ragazzo (voce letteraria).",
        "example": "Il fanciullo correva scalzo lungo la riva."
      }
    },
    "c_0542": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La linea che segna il confine di una superficie; anche lo spazio libero che si lascia intorno a uno scritto o il guadagno che resta.",
        "example": "Scrisse un appunto sul margine della pagina."
      }
    },
    "c_0883": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno dei sottili filamenti che crescono sul capo dell'uomo.",
        "example": "Si è tagliata i capelli cortissimi per l'estate."
      }
    }

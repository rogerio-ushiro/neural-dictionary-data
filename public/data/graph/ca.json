{
  "shard": "ca",
  "concepts": {
    "c_0201": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stirpe, razza (spesso con tono spregiativo).",
        "example": "Non voleva aver niente a che fare con quella genia di imbroglioni."
      }
    },
    "c_0308": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Antico veicolo a pedali, antenato della bicicletta.",
        "example": "Al museo è esposto un velocipede con la ruota anteriore enorme."
      }
    },
    "c_0551": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sporgenza della costa che si protende nel mare.",
        "example": "Il faro sorge sulla punta del promontorio."
      }
    },
    "c_0858": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte finale di un arto o di un oggetto allungato, il punto più lontano dal centro.",
        "example": "Ha battuto l'estremità del dito contro lo spigolo."
      }
    },
    "c_1022": {
      "revision": 2,
      "region_id": "r_natura",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Quantità minima e indivisibile di una sostanza in polvere o in minuti frammenti; se ne parla anche per dire una parte piccolissima di qualcosa (non un granello di buon senso).",
        "example": "Aveva ancora qualche granello di sabbia dentro le scarpe."
      }
    }
  },

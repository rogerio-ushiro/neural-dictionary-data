{
  "shard": "a9",
  "concepts": {
    "c_0129": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Macchina motrice che spinge o traina i vagoni di un treno.",
        "example": "Il locomotore elettrico è più silenzioso di quello diesel."
      }
    },
    "c_0451": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Frutto dalla buccia spessa e profumata e dalla polpa a spicchi, come l'arancia e il limone.",
        "example": "Spremette un agrume per la colazione."
      }
    },
    "c_0622": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il punto o il momento in cui una cosa comincia.",
        "example": "L'inizio del film è più lento del resto."
      }
    },
    "c_0745": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò su cui si regge una costruzione o un ragionamento; la parte più profonda e solida.",
        "example": "Le accuse si sono rivelate prive di fondamento."
      }
    },
    "c_0987": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Energia fisica e forza piena di chi è in salute; riferito a leggi e regole, l'essere in efficacia (una norma entra in vigore).",
        "example": "Nonostante gli anni, lavora ancora con grande vigore."
      }
    }
  },

{
  "shard": "f9",
  "concepts": {
    "c_0433": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bisogno di mangiare che si fa sentire quando lo stomaco è vuoto; al figurato, un desiderio intenso.",
        "example": "Dopo la camminata avevano una fame da lupi."
      }
    },
    "c_0446": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Disco di pasta lievitata condita con pomodoro, mozzarella e altri ingredienti, cotto al forno.",
        "example": "Il venerdì sera ordinano sempre la pizza."
      }
    },
    "c_0657": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Riposo e pace, soprattutto dopo una fatica o un dolore.",
        "example": "Non trovò requie finché non ebbe finito il lavoro."
      }
    },
    "c_0921": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il contorno scuro di una figura vista controluce.",
        "example": "Nel corridoio si stagliava la sagoma di una persona."
      }
    },
    "c_0994": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Suono continuo, sordo e vibrante, come quello di un'ape o di un motore lontano.",
        "example": "Il ronzio del frigorifero riempiva il silenzio della notte."
      }
    }
  },

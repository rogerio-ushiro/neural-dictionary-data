      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bisogno di mangiare che si fa sentire quando lo stomaco è vuoto; al figurato, un desiderio intenso.",
        "example": "Dopo la camminata avevano una fame da lupi."
      }
    },

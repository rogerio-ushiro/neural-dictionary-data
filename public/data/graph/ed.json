{
  "shard": "ed",
  "concepts": {
    "c_0002": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Striscia di sabbia o ghiaia lungo il mare, dove ci si stende al sole e si fa il bagno.",
        "example": "D'estate la spiaggia si riempie già di mattina."
      }
    },
    "c_0077": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il corpo celeste che gira attorno alla Terra e di notte ne riflette la luce del sole.",
        "example": "C'era la luna piena e si camminava senza torcia."
      }
    },
    "c_0785": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Componimento poetico solenne, spesso di argomento sacro o funebre.",
        "example": "Il poeta compose un carme per la morte dell'amico."
      }
    }
  },

      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lo spostarsi nell'acqua muovendo braccia e gambe, per sport o per non annegare.",
        "example": "Ha imparato il nuoto a cinque anni in piscina."
      }
    },
    "c_0127": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rete di binari e stazioni su cui viaggiano i treni.",
        "example": "La nuova ferrovia collega la costa alle città interne."
      }
    },

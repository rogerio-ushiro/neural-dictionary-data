{
  "shard": "10",
  "concepts": {
    "c_0294": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Invito a misurarsi in una prova; anche una difficoltà da affrontare.",
        "example": "Ha accettato la sfida di correre la maratona."
      }
    },
    "c_0423": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme del cibo necessario per vivere; anche ciò che spetta per il mantenimento.",
        "example": "Al collegio erano compresi vitto e alloggio."
      }
    },
    "c_0647": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grave perdita d'acqua da parte del corpo, che indebolisce e mette in pericolo.",
        "example": "Con quel caldo il rischio di disidratazione è alto."
      }
    },
    "c_0935": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Corso d'acqua di montagna dalla corrente rapida e dal letto sassoso, spesso in secca d'estate.",
        "example": "Dopo il temporale il torrente si gonfiò in poche ore."
      }
    },
    "c_0940": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il punto in cui un fiume sfocia nel mare o in un lago.",
        "example": "Alla foce del fiume nidificano molti uccelli acquatici."
      }
    }
  },

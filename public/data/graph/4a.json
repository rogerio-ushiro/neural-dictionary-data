{
  "shard": "4a",
  "concepts": {
    "c_0133": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi viaggia su un mezzo di trasporto senza guidarlo.",
        "example": "Il passeggero seduto accanto al finestrino dormiva."
      }
    },
    "c_0146": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chiusura fatta di due file di dentini che si incastrano tirando un cursore; si dice anche di ciò che unisce e fa da collegamento tra due parti.",
        "example": "La cerniera della giacca si è bloccata a metà."
      }
    },
    "c_0757": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Singola persona o singolo essere, considerato per sé e non come parte di un gruppo.",
        "example": "Ogni individuo reagisce alla notizia a modo suo."
      }
    },
    "c_0999": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Assenza di conflitti e di agitazione; stato di calma e serenità.",
        "example": "Dopo anni di liti tornò la pace in famiglia."
      }
    }
  },

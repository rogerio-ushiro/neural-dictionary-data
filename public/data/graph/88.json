{
  "shard": "88",
  "concepts": {
    "c_0056": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di minuti granelli di roccia che formano le spiagge e i deserti.",
        "example": "I bambini costruivano castelli di sabbia sulla battigia."
      }
    },
    "c_0122": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il momento in cui si raggiunge il luogo verso cui si era diretti.",
        "example": "All'arrivo trovarono ad aspettarli tutta la famiglia."
      }
    },
    "c_0629": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Del colore del sangue e del fuoco; è il colore del cielo al tramonto.",
        "example": "Il cielo si fece rosso dietro le montagne."
      }
    }
  },

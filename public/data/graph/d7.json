  "concepts": {
    "c_0163": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il progressivo estendersi delle città sul territorio.",
        "example": "L'urbanizzazione ha consumato molti terreni agricoli."
      }
    },
    "c_0677": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Passatempo che distrae dalle occupazioni serie.",
        "example": "Il teatro era la sua unica diversione settimanale."
      }
    },
    "c_0732": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Strada principale a scorrimento veloce che collega le parti di una città; nel corpo, il vaso che porta il sangue dal cuore.",
        "example": "L'arteria di scorrimento era bloccata dal traffico."
      }
    }
  },

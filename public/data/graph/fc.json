{
  "shard": "fc",
  "concepts": {
    "c_0188": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La copertura superiore di un edificio, che ripara da pioggia e sole.",
        "example": "Il vento aveva scoperchiato una parte del tetto."
      }
    },
    "c_0221": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il piccolo del cane e di altri mammiferi; con affetto, un bambino.",
        "example": "Il cucciolo mordicchiava le pantofole di tutti."
      }
    },
    "c_0254": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il processo con cui una persona acquisisce conoscenze e capacità per una professione.",
        "example": "Ha seguito un corso di formazione per infermieri."
      }
    },
    "c_0395": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il punto più alto di una montagna.",
        "example": "Raggiunsero la vetta poco prima di mezzogiorno."
      }
    },
    "c_0504": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'emettere con la voce suoni musicali; anche il brano che si canta.",
        "example": "Dai campi saliva il canto dei mietitori."
      }
    },
    "c_0571": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La direzione da tenere durante un viaggio per mare o per aria; al figurato, la linea di condotta scelta.",
        "example": "Il comandante corresse la rotta per evitare la tempesta."
      }
    },
    "c_0669": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sentimento profondo di affetto e attrazione che lega a una persona o a una cosa.",
        "example": "Il loro amore è nato sui banchi di scuola."
      }
    },
    "c_0687": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Permesso ufficiale di fare o esercitare qualcosa; anche un eccesso di libertà nei modi.",
        "example": "Ha ottenuto la licenza per aprire il locale."
      }
    },
    "c_0962": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Involucro di aria che avvolge la Terra; anche il clima emotivo che si respira in un luogo.",
        "example": "In sala regnava un'atmosfera di attesa."
      }
    },
    "c_1006": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Dolcezza e moderazione di modi; anche la clemenza del clima.",
        "example": "Lo colpì la mitezza con cui rispose all'offesa."
      }
    }
  },

      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino piccolo (voce affettuosa e letteraria).",
        "example": "Teneva il pargolo stretto tra le braccia."
      }
    },
    "c_0541": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte solida dei continenti, contrapposta al mare.",
        "example": "Dopo settimane di navigazione avvistarono la terraferma."
      }
    },
    "c_0880": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Semplice e senza pretese, come la vita e le cose di campagna.",
        "example": "Il pranzo fu rustico ma abbondante: pane, salame e vino."
      }
    }
  },

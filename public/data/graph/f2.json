  "concepts": {
    "c_0083": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il sesto mese dell'anno, quando comincia l'estate.",
        "example": "A giugno finisce la scuola e cominciano gli esami."
      }
    },
    "c_0177": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampia parte di un territorio con caratteristiche proprie, spesso con un'amministrazione autonoma.",
        "example": "In quella regione si parla ancora un dialetto antico."
      }
    },
    "c_0704": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'essere in movimento anziché fermo; in fisica, il cambiamento di posizione di un corpo nel tempo.",
        "example": "Il treno si mise lentamente in moto."
      }
    }
  },

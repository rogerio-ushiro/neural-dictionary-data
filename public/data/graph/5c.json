{
  "shard": "5c",
  "concepts": {
    "c_0290": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno degli incontri in cui si svolge un gioco o uno sport tra due contendenti.",
        "example": "La partita è stata rinviata per pioggia."
      }
    },
    "c_0427": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Introdurre cibo nel corpo per nutrirsi.",
        "example": "Con quel mal di gola non riusciva a mangiare nulla di solido."
      }
    },
    "c_0643": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ondata di calore intenso e improvviso, come quella che sale da un forno.",
        "example": "Aprendo lo sportello lo investì una vampata."
      }
    },
    "c_0728": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Parte della fisica che studia il moto dei corpi e le forze che lo causano; anche il funzionamento interno di qualcosa.",
        "example": "Non capiva la meccanica di quel giocattolo a molla."
      }
    },
    "c_0931": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte dura al centro di certi frutti, che contiene il seme.",
        "example": "Sputò il nocciolo dell'oliva nel piatto."
      }
    },
    "c_0944": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vapore o gas che si sprigiona da un corpo, spesso maleodorante.",
        "example": "Dalla palude salivano esalazioni sgradevoli."
      }
    }
  },

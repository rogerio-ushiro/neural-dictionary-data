{
  "shard": "48",
  "concepts": {
    "c_0184": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Luogo dove si è ospitati o si vive temporaneamente.",
        "example": "L'alloggio era piccolo ma pulito e vicino al centro."
      }
    },
    "c_0258": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Materia di studio; anche la capacità di rispettare regole e ordine.",
        "example": "La matematica è la disciplina che preferisce."
      }
    },
    "c_0399": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Linea di roccia frastagliata che corre lungo la sommità di un monte; anche il ciuffo di penne sul capo di certi uccelli.",
        "example": "Camminarono lungo la cresta con il vuoto da entrambe le parti."
      }
    },
    "c_0401": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Terreno che si eleva rispetto a quello circostante, meno di una montagna.",
        "example": "La cascina sorge su un'altura ventosa."
      }
    },
    "c_0496": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sequenza di note che, cantata o suonata, forma un motivo riconoscibile e piacevole.",
        "example": "Fischiettava una melodia allegra andando a lavoro."
      }
    },
    "c_0508": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'altezza e il colore di un suono o di una voce; anche l'atteggiamento che traspare dal modo di parlare.",
        "example": "Rispose con un tono seccato."
      }
    },
    "c_0610": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualità di ciò che brilla ed emette molta luce.",
        "example": "La brillantezza dello smalto durò tutta la stagione."
      }
    },
    "c_0665": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Un tornare a vivere e a fiorire dopo un periodo di declino.",
        "example": "La primavera è il simbolo della rinascita della natura."
      }
    }
  },

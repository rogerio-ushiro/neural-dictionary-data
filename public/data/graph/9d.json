{
  "shard": "9d",
  "concepts": {
    "c_0190": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Luogo dove ci si mette al sicuro da un pericolo o dalle intemperie.",
        "example": "Trovarono rifugio in una baita durante il temporale."
      }
    },
    "c_0473": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Denso e morbido come una crema.",
        "example": "Il risotto era cotto al punto giusto, ben cremoso."
      }
    },
    "c_0587": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pietra che attira il ferro e ha due poli magnetici.",
        "example": "Attaccò il disegno al frigorifero con una calamita."
      }
    },
    "c_0604": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Calore appassionato con cui ci si dedica a qualcosa.",
        "example": "Lavora al progetto con grande fervore."
      }
    },
    "c_0976": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il tenersi in disparte con freddezza, senza coinvolgersi.",
        "example": "Rispose con un distacco che ferì più di un rimprovero."
      }
    }
  },

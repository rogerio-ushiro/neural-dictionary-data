  "shard": "c4",
  "concepts": {
    "c_0038": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Arte di combinare suoni e ritmi in modo gradevole all'orecchio; anche l'insieme dei brani che si ascoltano.",
        "example": "Studia musica da quando aveva sei anni."
      }
    },
    "c_0360": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fiore a coppa dai colori vivaci che sboccia in primavera da un bulbo.",
        "example": "Nel prato erano spuntati centinaia di tulipani rossi."
      }
    },
    "c_0830": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sentiero stretto e poco battuto.",
        "example": "Una stradetta in salita portava alla cappella."
      }
    }
  },

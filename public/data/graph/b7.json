{
  "shard": "b7",
  "concepts": {
    "c_0130": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Luogo attrezzato dove i treni si fermano per far salire e scendere i passeggeri.",
        "example": "Ci vediamo davanti all'ingresso della stazione."
      }
    },
    "c_0145": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Parte di un oggetto per cui lo si afferra e si regge.",
        "example": "Il manico della borsa si è staccato."
      }
    },
    "c_0448": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Impasto di farina e acqua tirato e tagliato in vari formati, che si lessa e si condisce.",
        "example": "Ha buttato la pasta appena l'acqua ha bollito."
      }
    },
    "c_0659": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sonno profondo e prolungato in cui certi animali passano l'inverno.",
        "example": "L'orso esce dal letargo quando la neve si scioglie."
      }
    },
    "c_0754": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi cosa che esiste, dotata o no di vita; spesso l'uomo o un animale.",
        "example": "Ogni essere merita rispetto."
      }
    }
  },

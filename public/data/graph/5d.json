{
  "shard": "5d",
  "concepts": {
    "c_0200": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte del tronco che resta nel terreno quando si taglia un albero; al figurato, il capostipite di una famiglia.",
        "example": "Si sedette su un ceppo a riposare."
      }
    },
    "c_0309": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi mezzo che serve a trasportare persone o cose su strada, rotaia, acqua o aria.",
        "example": "Il veicolo è rimasto in panne sulla corsia di emergenza."
      }
    },
    "c_0550": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il fissare una nave in un punto con l'ancora perché non si sposti.",
        "example": "Il fondale sabbioso offriva un buon ancoraggio."
      }
    },
    "c_0859": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rivestimento corneo che protegge il piede di cavalli, buoi e altri animali.",
        "example": "Il maniscalco ferrava gli zoccoli del cavallo."
      }
    },
    "c_1023": {
      "revision": 2,
      "region_id": "r_lavoro",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi interviene per portare aiuto a una persona in pericolo o in difficoltà, spesso prima che arrivino i mezzi specializzati.",
        "example": "I soccorritori raggiunsero l'escursionista poco prima del buio."
      }
    }
  },

{
  "shard": "d5",
  "concepts": {
    "c_0271": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Raccolta ordinata di leggi o di regole; anche un lungo manoscritto antico.",
        "example": "Il codice della strada punisce quell'infrazione con una multa."
      }
    },
    "c_0345": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stato d'animo calmo e limpido, senza turbamenti.",
        "example": "Il giardino gli trasmetteva una grande serenità."
      }
    },
    "c_0468": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gelato morbido e spumoso servito a fette.",
        "example": "A fine cena portarono uno spumone al torroncino."
      }
    },
    "c_0521": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il comparire delle prime luci del mattino.",
        "example": "All'albeggiare i galli cominciarono a cantare."
      }
    },
    "c_0639": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Nebbia leggera che vela il paesaggio.",
        "example": "Una foschia dorata avvolgeva la campagna al mattino."
      }
    },
    "c_0815": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle condizioni naturali e sociali in cui si vive; anche il clima morale di un luogo.",
        "example": "Bisogna proteggere l'ambiente dall'inquinamento."
      }
    }
  },

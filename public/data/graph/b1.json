{
  "shard": "b1",
  "concepts": {
    "c_0165": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lo stato di sviluppo di un popolo per leggi, arti e costumi; anche l'insieme dei popoli di un'epoca.",
        "example": "La scrittura segna il passaggio a una civiltà più complessa."
      }
    },
    "c_0239": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il padre del trisnonno; antenato di cinque generazioni prima.",
        "example": "Del trisavo restava solo un ritratto sbiadito."
      }
    },
    "c_0569": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle grandi masse di terra emersa in cui si divide il pianeta.",
        "example": "Ha visitato quattro continenti in dieci anni."
      }
    },
    "c_0671": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Attività leggera che distoglie la mente da pensieri e fatiche.",
        "example": "Il giardinaggio è la sua distrazione dopo l'ufficio."
      }
    },
    "c_0734": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il tragitto che un fiume o una strada seguono nel loro sviluppo; indica anche una serie di lezioni su una materia.",
        "example": "Il corso del fiume forma un'ampia ansa a valle."
      }
    },
    "c_0958": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stato di ciò che è teso e sul punto di cedere; tra persone, un clima carico di ostilità trattenuta.",
        "example": "Durante la riunione si tagliava la tensione con un coltello."
      }
    }
  },

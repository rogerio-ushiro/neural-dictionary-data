  "concepts": {
    "c_0243": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi ha occupato una carica prima di un altro; anche un antenato.",
        "example": "Il predecessore aveva lasciato l'ufficio in ordine perfetto."
      }
    },
    "c_0513": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Scendere verso il basso; detto del sole, avvicinarsi al tramonto.",
        "example": "Al calare della sera si accesero i primi lampioni."
      }
    },
    "c_0588": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Evento improvviso che provoca gravi danni e vittime.",
        "example": "L'alluvione fu il peggiore disastro degli ultimi cento anni."
      }
    },
    "c_0979": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il modo in cui una cosa appare, che può non corrispondere alla realtà.",
        "example": "A prima apparenza sembrava disabitato."
      }
    },
    "c_1015": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi va per mare o per fiumi a catturare pesci come mestiere.",
        "example": "I pescatori rientravano all'alba con le reti cariche."
      }
    }
  },

{
  "shard": "6e",
  "concepts": {
    "c_0186": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Costruzione con muri e tetto destinata ad abitazione o ad altri usi.",
        "example": "Il nuovo edificio ospiterà la biblioteca comunale."
      }
    },
    "c_0403": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Valico tra due monti, punto più basso di una cresta per cui si passa.",
        "example": "Il giogo era ancora coperto di neve a maggio."
      }
    },
    "c_0494": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di persone riunite per deliberare su questioni comuni.",
        "example": "L'assemblea dei condomini ha approvato i lavori."
      }
    },
    "c_0612": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il grado di forza con cui una luce, un suono o un sentimento si manifesta.",
        "example": "Abbassò l'intensità della lampada per leggere."
      }
    },
    "c_0667": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Nuovo getto che spunta da un seme, da un ramo o da una gemma.",
        "example": "Sul ramo tagliato erano già spuntati due germogli."
      }
    },
    "c_0689": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il liberarsi da una condizione di schiavitù o di colpa, spesso pagando un prezzo.",
        "example": "Vedeva nel lavoro onesto la via del riscatto."
      }
    },
    "c_1008": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi natante costruito per galleggiare e spostarsi sull'acqua.",
        "example": "Un'imbarcazione da diporto era ormeggiata al pontile."
      }
    }
  },

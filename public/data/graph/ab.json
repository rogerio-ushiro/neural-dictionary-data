      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il gruppo di persone unite da vincoli di sangue o di matrimonio che di solito vivono insieme.",
        "example": "La domenica pranza tutta la famiglia dai nonni."
      }

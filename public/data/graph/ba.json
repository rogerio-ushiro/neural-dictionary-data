{
  "shard": "ba",
  "concepts": {
    "c_0182": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il luogo dove si abita, la casa in cui si vive (voce elevata).",
        "example": "Fissò la propria dimora ai margini del bosco."
      }
    },
    "c_0407": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fianco inclinato di un monte o di una collina.",
        "example": "Scendevano il pendio con cautela sull'erba bagnata."
      }
    },
    "c_0490": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sentimento vivo di felicità.",
        "example": "La notizia della nascita portò gioia in tutta la casa."
      }
    },
    "c_0616": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualità di un'immagine o di un suono ben definiti e privi di disturbi.",
        "example": "La nitidezza della foto permetteva di leggere l'insegna sullo sfondo."
      }
    },
    "c_0663": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stato di calma serena, senza preoccupazioni né agitazione.",
        "example": "La musica gli dava una grande tranquillità."
      }
    },
    "c_0968": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Estremamente freddo, da paesaggio di ghiacci; riferito a modi e sguardi, di gelida ostilità.",
        "example": "Soffiava un vento glaciale dalla montagna."
      }
    }
  },

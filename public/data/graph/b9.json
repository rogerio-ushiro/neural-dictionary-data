{
  "shard": "b9",
  "concepts": {
    "c_0240": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il capo più anziano e autorevole di una grande famiglia.",
        "example": "Il bisnonno era il patriarca indiscusso della casa."
      }
    },
    "c_0510": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte del giorno in cui manca la luce del sole e di solito si dorme.",
        "example": "Di notte il paese è così silenzioso da sentire il fiume."
      }
    },
    "c_0608": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle luci che rendono chiaro un ambiente.",
        "example": "L'illuminazione del corridoio si accende al passaggio."
      }
    },
    "c_1016": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Spingere avanti una barca immergendo e tirando i remi.",
        "example": "Remò controcorrente per un'ora buona."
      }
    }
  },

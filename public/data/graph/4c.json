{
  "shard": "4c",
  "concepts": {
    "c_0247": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Istituzione che offre gli studi superiori, rilascia le lauree e svolge ricerca.",
        "example": "Si è iscritto all'università di lettere a settembre."
      }
    },
    "c_0478": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccola coppa in cui si serve una porzione di gelato.",
        "example": "Prese una coppetta al limone dopo cena."
      }
    },
    "c_0517": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Coperto di stelle, detto del cielo notturno sereno.",
        "example": "Cenammo sotto un cielo stellato in mezzo ai campi."
      }
    },
    "c_1011": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi comanda una nave e risponde della rotta e dell'equipaggio.",
        "example": "Il capitano diede l'ordine di gettare l'ancora."
      }
    }
  },

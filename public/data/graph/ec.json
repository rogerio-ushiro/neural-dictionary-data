{
  "shard": "ec",
  "concepts": {
    "c_0113": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gruppo ordinato di veicoli o persone che viaggiano insieme, spesso sotto scorta.",
        "example": "Un convoglio di camion militari attraversò il paese."
      }
    },
    "c_0777": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La condizione di chi è più in alto o vale più degli altri.",
        "example": "Non gli piaceva ostentare la propria superiorità."
      }
    },
    "c_0799": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme di arbusti e piante basse che crescono sotto gli alberi di un bosco.",
        "example": "Il fagiano si nascose nel sottobosco."
      }
    }
  },

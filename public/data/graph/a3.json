{
  "shard": "a3",
  "concepts": {
    "c_0295": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Confronto tra due o più contendenti per stabilire chi è il migliore.",
        "example": "La competizione tra le due squadre è sempre accesa."
      }
    },
    "c_0422": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che serve a mantenere in vita e a far crescere il corpo.",
        "example": "Il latte materno è il primo nutrimento del bambino."
      }
    },
    "c_0646": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Mancanza di umidità; anche l'asprezza di modi di chi risponde a monosillabi.",
        "example": "La secchezza dell'aria gli irritava la gola."
      }
    },
    "c_0934": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Frammento piccolissimo di materia; al figurato, una quantità minima di qualcosa.",
        "example": "Non c'era una particella di polvere sui mobili."
      }
    },
    "c_0941": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il formarsi di goccioline quando il vapore incontra una superficie fredda.",
        "example": "La condensa appannava il vetro della finestra."
      }
    }
  },

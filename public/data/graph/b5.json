{
  "shard": "b5",
  "concepts": {
    "c_0222": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino paffuto raffigurato nell'arte come un angioletto nudo.",
        "example": "Sulla volta della chiesa erano dipinti dei putti tra le nuvole."
      }
    },
    "c_0257": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stanza della scuola dove si tengono le lezioni.",
        "example": "L'aula in fondo al corridoio ha la lavagna nuova."
      }
    },
    "c_0396": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cima aguzza e isolata di una montagna.",
        "example": "Il picco più alto della catena supera i quattromila metri."
      }
    },
    "c_0499": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Accordo piacevole di suoni che stanno bene insieme; al figurato, la concordia tra persone o parti.",
        "example": "Nel coro le voci si fondevano in perfetta armonia."
      }
    },
    "c_0507": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il suono prodotto dall'apparato vocale dell'uomo per parlare o cantare.",
        "example": "Riconobbe la sua voce al telefono dopo anni."
      }
    },
    "c_0572": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di azioni con cui si guida e si sposta una nave, un'auto o un aereo.",
        "example": "La manovra di parcheggio in quello spazio stretto fu delicata."
      }
    },
    "c_0684": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il potere o la possibilità riconosciuta di fare qualcosa; anche una branca dell'università.",
        "example": "Ha la facoltà di firmare al posto del direttore."
      }
    },
    "c_0961": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Nelle religioni, il luogo di felicità eterna dopo la morte; al figurato, un posto meraviglioso.",
        "example": "Quell'isola sperduta era un piccolo paradiso."
      }
    },
    "c_1005": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Mancanza di movimento o di reazione; anche la pigrizia di chi non prende iniziative.",
        "example": "Lo Stato è rimasto nell'inerzia di fronte al problema."
      }
    }
  },

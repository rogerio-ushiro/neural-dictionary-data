{
  "shard": "4e",
  "concepts": {
    "c_0313": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualunque cosa serva a raggiungere uno scopo o a spostarsi; al plurale, le risorse economiche di cui si dispone.",
        "example": "La bicicletta è il suo mezzo preferito per andare in ufficio."
      }
    },
    "c_0384": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La capacità di un terreno o di un essere vivente di produrre frutti e nuova vita.",
        "example": "Le piene del fiume aumentano la fertilità dei campi."
      }
    },
    "c_0843": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bestia feroce e pericolosa; anche una grande esposizione con vendita di merci e bestiame.",
        "example": "Il domatore entrò nella gabbia della fiera."
      }
    },
    "c_1035": {
      "revision": 2,
      "region_id": "r_movimento",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Punto della costa dove ci si accosta con la barca e si sbarca; al figurato, la situazione sicura raggiunta dopo un periodo difficile.",
        "example": "Dopo mesi in mare aperto, il porto fu un approdo tanto atteso."
      }
    }
  },

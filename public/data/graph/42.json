{
  "shard": "42",
  "concepts": {
    "c_0270": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Arte di comporre in versi; anche il singolo componimento.",
        "example": "Ha imparato a memoria una poesia per la recita."
      }
    },
    "c_0344": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Barriera che chiude e delimita un terreno.",
        "example": "Ha rinforzato il recinto per tenere fuori i cinghiali."
      }
    },
    "c_0469": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Dolce gelato a forma di fetta o di cupola, con più gusti e canditi.",
        "example": "La cassata siciliana è ricca di ricotta e frutta candita."
      }
    },
    "c_0520": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La prima luce chiara del giorno che spunta a oriente.",
        "example": "All'albore si mise in cammino verso il valico."
      }
    },
    "c_0638": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che resta nascosto e non si riesce a spiegare.",
        "example": "La sua sparizione è rimasta un mistero."
      }
    },
    "c_0814": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che è di un verde vivo e naturale (voce letteraria).",
        "example": "Il pendio era coperto di un manto silvestre."
      }
    }
  },

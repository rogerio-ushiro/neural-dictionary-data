  "concepts": {
    "c_0436": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pane basso e schiacciato, condito con olio e sale e a volte farcito.",
        "example": "Comprò una focaccia calda appena sfornata."
      }
    },
    "c_0443": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Involucro esterno del pane, dorato e croccante per la cottura.",
        "example": "Tagliò via la crosta bruciacchiata."
      }
    },
    "c_0652": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il progressivo indebolirsi e consumarsi di un corpo o di un ambiente.",
        "example": "La siccità causò il deperimento di tutta la vegetazione."
      }
    },
    "c_0924": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tessuto sottile e trasparente; al figurato, ciò che nasconde appena qualcosa.",
        "example": "Un velo di nebbia copriva i campi al mattino."
      }
    },
    "c_0991": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rumore improvviso, forte e disordinato, di cose che cadono o si rompono.",
        "example": "Dalla cucina arrivò un gran fracasso di piatti rotti."
      }
    }
  },

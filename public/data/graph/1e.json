{
  "shard": "1e",
  "concepts": {
    "c_0164": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo centro abitato di campagna, con poche case raccolte attorno a una piazza.",
        "example": "Nel villaggio c'è un solo negozio che vende di tutto."
      }
    },
    "c_0238": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il padre del bisnonno; antenato di quattro generazioni prima.",
        "example": "Il bisavo aveva costruito la casa con le proprie mani."
      }
    },
    "c_0568": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lingua di terra che si protende nel mare rimanendo unita al continente.",
        "example": "La penisola si spinge per venti chilometri nel golfo."
      }
    },
    "c_0670": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piacere sereno e raffinato che si prova in un'attività amata.",
        "example": "Legge poesia con vero diletto."
      }
    },
    "c_0735": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Villaggio molto piccolo.",
        "example": "È cresciuto in un paesetto di poche case sulle colline."
      }
    },
    "c_0959": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Superficie curva che copre uno spazio dall'alto, come quella di una cupola o del cielo.",
        "example": "Alzò gli occhi verso la volta stellata."
      }
    }
  },

{
  "shard": "46",
  "concepts": {
    "c_0322": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Animale che cammina appoggiandosi su quattro arti, come il cavallo o il cane.",
        "example": "Nella stalla c'erano diversi quadrupedi da lavoro."
      }
    },
    "c_0357": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Odore gradevole, come quello dei fiori.",
        "example": "Nell'aria si spandeva il profumo dei tigli."
      }
    },
    "c_0807": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampia superficie piatta e uniforme.",
        "example": "Davanti a loro si apriva una distesa di sabbia bianca."
      }
    },
    "c_0872": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Reso mansueto e abituato a vivere accanto all'uomo, detto di un animale.",
        "example": "Il gatto selvatico non si lascia addomesticare facilmente."
      }
    },
    "c_0898": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fusto sottile ed erbaceo che regge il fiore o la foglia.",
        "example": "Il gambo del girasole era spesso come un polso."
      }
    },
    "c_1044": {
      "revision": 2,
      "region_id": "r_oggetti",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Oggetto fatto per tenere altre cose al proprio interno.",
        "example": "Travasò la farina in un contenitore a chiusura ermetica."
      }
    }
  },

      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il girare attorno a un asse o a un centro, come fa una ruota o la Terra.",
        "example": "La rotazione delle colture mantiene fertile il terreno."
      }
    }

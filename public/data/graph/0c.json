  "concepts": {
    "c_0302": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vasta estensione di alberi fitti, più grande e selvaggia di un bosco.",
        "example": "La foresta si estendeva a perdita d'occhio dalla vetta."
      }
    },
    "c_0852": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il mammifero dotato di ragione e linguaggio; l'essere umano.",
        "example": "L'uomo ha imparato a controllare il fuoco molto presto."
      }
    },
    "c_1028": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle minuscole particelle in cui si sgretola una sostanza come la sabbia o il sale.",
        "example": "Un granello di sabbia gli era entrato nell'occhio."
      }
    }
  },

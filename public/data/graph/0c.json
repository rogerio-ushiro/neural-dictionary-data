  "shard": "0c",
  "concepts": {
    "c_0302": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vasta estensione di alberi fitti, più grande e selvaggia di un bosco.",
        "example": "La foresta si estendeva a perdita d'occhio dalla vetta."
      }
    },
    "c_0852": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il mammifero dotato di ragione e linguaggio; l'essere umano.",
        "example": "L'uomo ha imparato a controllare il fuoco molto presto."
      }
    },
    "c_1028": {
      "revision": 2,
      "region_id": "r_tempo",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tratto di tempo con un inizio e una fine, considerato come un'unica fase (il periodo delle piogge, un brutto periodo).",
        "example": "Ha lavorato all'estero per un lungo periodo."
      }
    }
  },

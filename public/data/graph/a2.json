{
  "shard": "a2",
  "concepts": {
    "c_0021": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampio spazio verde pubblico, con alberi e vialetti, dove si passeggia e ci si riposa.",
        "example": "Al parco i bambini giocano a pallone fino a sera."
      }
    },
    "c_0094": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Liquido salato che la pelle emette per il caldo o lo sforzo, e che raffredda il corpo evaporando.",
        "example": "Si asciugò il sudore dalla fronte con la manica."
      }
    },
    "c_0379": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Reso umido o coperto d'acqua.",
        "example": "Rientrò a casa bagnato fradicio dalla pioggia."
      }
    },
    "c_0829": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La misura di quanto una cosa si estende verso il basso o verso l'interno; al figurato, l'intensità di un pensiero.",
        "example": "Non si conosceva la profondità del pozzo."
      }
    }
  },

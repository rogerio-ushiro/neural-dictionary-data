{
  "shard": "74",
  "concepts": {
    "c_0315": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di anelli metallici uniti l'uno all'altro, usata per legare, sollevare o trasmettere il moto ai pedali.",
        "example": "La catena della bici è uscita dagli ingranaggi."
      }
    },
    "c_0382": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bassa temperatura che fa rabbrividire e cercare riparo; riferito ai modi di una persona, mancanza di calore e cordialità.",
        "example": "Fa un freddo pungente stamattina."
      }
    },
    "c_0845": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che vive nei boschi allo stato naturale, non allevato dall'uomo.",
        "example": "Nella tana c'era una covata di conigli selvatici."
      }
    },
    "c_1033": {
      "revision": 2,
      "region_id": "r_corpo",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Segno con cui una malattia si manifesta e che permette di riconoscerla; più in generale, l'indizio di qualcosa che non va.",
        "example": "La tosse fu il primo sintomo dell'influenza."
      }
    }
  },

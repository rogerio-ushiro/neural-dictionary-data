      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Prolungamento della spina dorsale di molti animali, usato per equilibrio o per comunicare; al figurato, la parte finale di qualcosa (la coda della fila).",
        "example": "Il gatto agitava la coda infastidito."
      }
    },
    "c_0865": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lamina dura all'estremità delle dita, che protegge il polpastrello.",
        "example": "Si è spezzata un'unghia aprendo la scatola."
      }
    }

  "concepts": {
    "c_0202": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stirpe, discendenza di una famiglia (spesso con valore spregiativo).",
        "example": "Veniva da una schiatta di prepotenti, dicevano in paese."
      }
    },
    "c_0552": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Spazio vuoto all'interno di un corpo o del terreno.",
        "example": "Il torrente ha scavato una cavità nella parete."
      }
    },
    "c_1021": {
      "revision": 2,
      "region_id": "r_natura",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo animale marino che vive in colonie e forma scogliere ramificate.",
        "example": "Nuotando sopra la barriera vedeva il corallo rosa e giallo."
      }
    }
  },

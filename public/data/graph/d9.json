  "concepts": {
    "c_0323": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Emettere il verso forte e ripetuto tipico del cane.",
        "example": "Il cane abbaiava furiosamente al postino."
      }
    },
    "c_0356": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle lamine colorate che formano la corolla di un fiore.",
        "example": "Sfogliava la margherita staccando un petalo alla volta."
      }
    },
    "c_0806": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Erba tagliata e seccata, conservata per nutrire il bestiame d'inverno.",
        "example": "Il fienile era pieno di fieno profumato."
      }
    },
    "c_0873": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che riguarda la famiglia o le persone con cui si vive; anche noto perché consueto.",
        "example": "Ha un tono familiare anche con gli sconosciuti."
      }
    },
    "c_0899": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fusto sottile e allungato di una pianta erbacea o di un fiore.",
        "example": "Recise il fiore lasciando uno stelo lungo per il vaso."
      }
    }
  },

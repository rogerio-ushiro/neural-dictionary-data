{
  "shard": "83",
  "concepts": {
    "c_0453": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Agrume tondo dalla buccia arancione e dalla polpa dolce a spicchi.",
        "example": "A colazione beve sempre una spremuta d'arancia."
      }
    },
    "c_0620": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di fasi che si ripetono sempre nello stesso ordine, come quello del giorno e della notte.",
        "example": "Il ciclo delle stagioni scandisce i lavori nei campi."
      }
    },
    "c_0747": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte inferiore su cui una cosa poggia; il punto di partenza di un ragionamento.",
        "example": "La colonna poggia su una base di marmo."
      }
    },
    "c_0985": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sollievo dato da qualcosa di fresco quando fa molto caldo.",
        "example": "Un tuffo in piscina fu un vero refrigerio."
      }
    }
  },

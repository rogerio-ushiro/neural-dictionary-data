{
  "shard": "13",
  "concepts": {
    "c_0084": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Calore secco e opprimente che secca la gola e la terra.",
        "example": "Nell'arsura di luglio i campi diventavano gialli."
      }
    },
    "c_0170": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La terra in cui si è nati, a cui ci si sente legati.",
        "example": "Ha lasciato la patria a vent'anni e non è più tornato."
      }
    },
    "c_0703": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Assalto rapido e deciso contro un avversario; anche la quantità di energia caricata in una batteria.",
        "example": "La carica dei soldati sfondò la linea nemica."
      }
    }
  },

  "concepts": {
    "c_0064": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Costruzione di sabbia bagnata che i bambini modellano sulla spiaggia.",
        "example": "L'onda si portò via il castello appena finito."
      }
    },
    "c_0118": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il fatto di cambiare posizione o di non stare fermi; si usa anche per una corrente di idee o di persone che agiscono insieme per uno scopo (un movimento artistico, un movimento politico).",
        "example": "Con un movimento della mano fece cenno di avvicinarsi."
      }
    },
    "c_0792": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi partecipa con un altro a un'azione, di solito illecita.",
        "example": "È stato arrestato insieme al suo complice."
      }
    }
  },

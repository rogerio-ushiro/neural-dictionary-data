{
  "shard": "55",
  "concepts": {
    "c_0103": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Autorizzazione ad assentarsi dal lavoro o dal servizio per un periodo.",
        "example": "Ha chiesto un giorno di congedo per motivi familiari."
      }
    },
    "c_0486": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Fatto di rilievo che accade in un momento preciso.",
        "example": "Il concerto è stato l'evento dell'estate in paese."
      }
    },
    "c_0712": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stato di forte irrequietezza, fisica o d'animo, con movimenti scomposti e nervosi.",
        "example": "Nella sala d'attesa c'era una certa agitazione."
      }
    },
    "c_0767": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi ha dato inizio a un'istituzione, un'impresa o una città.",
        "example": "Il fondatore dell'azienda partì da una piccola bottega."
      }
    }
  },

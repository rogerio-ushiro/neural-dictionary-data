  "shard": "cc",
  "concepts": {
    "c_0081": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il settimo mese dell'anno, nel pieno dell'estate.",
        "example": "A luglio la scuola è chiusa e si va al mare."
      }
    },
    "c_0175": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il suolo su cui si vive e si coltiva; anche il paese di cui si è originari.",
        "example": "Dopo anni all'estero tornò nella sua terra."
      }
    },
    "c_0706": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La facilità con cui una persona o una cosa può spostarsi; indica anche la possibilità di cambiare condizione sociale o lavoro.",
        "example": "Dopo l'incidente ha recuperato la mobilità del braccio."
      }
    }
  },

      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Luce fioca e incerta, come quella di una stanza in penombra.",
        "example": "Nella penombra della chiesa si distinguevano appena gli affreschi."
      }
    },
    "c_0742": {

{
  "shard": "9f",
  "concepts": {
    "c_0303": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stretto passaggio battuto dai passi, che attraversa boschi e campagne dove non c'è strada.",
        "example": "Il sentiero sale ripido fino al passo."
      }
    },
    "c_0853": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il momento in cui la femmina dà alla luce il piccolo.",
        "example": "Il parto è andato bene e il vitello sta in piedi."
      }
    },
    "c_1029": {
      "revision": 2,
      "region_id": "r_tempo",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle dodici parti in cui si divide l'anno, lunga poco più di quattro settimane.",
        "example": "Manca ancora un mese alla partenza."
      }
    }
  },

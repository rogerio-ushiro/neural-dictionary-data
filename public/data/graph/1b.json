      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La striscia di sabbia bagnata dove le onde si spingono e si ritirano.",
        "example": "Passeggiavano scalzi sulla battigia."
      }
    },
    "c_0123": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Esperienza fuori dall'ordinario, piena di imprevisti e di rischio, ma anche di scoperta.",
        "example": "Attraversare il deserto è stata una vera avventura."
      }
    },
    "c_0628": {

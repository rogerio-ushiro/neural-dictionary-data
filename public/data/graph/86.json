{
  "shard": "86",
  "concepts": {
    "c_0230": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi dà origine a qualcosa, chi lo fa esistere.",
        "example": "È considerato il creatore di quel genere musicale."
      }
    },
    "c_0285": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi accompagna qualcuno in un viaggio o in una visita.",
        "example": "La comitiva era guidata da un accompagnatore esperto."
      }
    },
    "c_0414": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Terreno basso e acquitrinoso, coperto d'acqua stagnante e vegetazione.",
        "example": "Nella palude gracidavano le rane al tramonto."
      }
    },
    "c_0560": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Materiale duro di cui sono fatte le rocce; anche un frammento di essa.",
        "example": "Il muretto a secco è costruito con pietre sovrapposte."
      }
    },
    "c_0678": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Scoppio di allegria che fa ridere ad alta voce.",
        "example": "Dalla stanza accanto arrivavano risate senza fine."
      }
    },
    "c_0692": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gruppo di persone armate che accompagna e protegge qualcuno o qualcosa durante il tragitto.",
        "example": "Il camion blindato viaggiava con la scorta della polizia."
      }
    },
    "c_0951": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tratto proprio di una persona o di una cosa che la distingue dalle altre.",
        "example": "La puntualità è la sua caratteristica principale."
      }
    }
  },

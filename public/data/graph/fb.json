{
  "shard": "fb",
  "concepts": {
    "c_0466": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Reso duro e freddissimo dal ghiaccio.",
        "example": "Il terreno era ghiacciato e scivoloso all'alba."
      }
    },
    "c_0592": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il rivestimento esterno del corpo, che protegge dall'ambiente e percepisce il tatto.",
        "example": "Il sole gli aveva arrossato la pelle delle spalle."
      }
    },
    "c_0637": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cavità naturale nella roccia o sottoterra.",
        "example": "Nella caverna hanno trovato pitture di migliaia di anni fa."
      }
    },
    "c_0905": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vasca artificiale piena d'acqua dove si nuota per sport o per svago.",
        "example": "In estate frequenta la piscina comunale tre volte a settimana."
      }
    }
  },

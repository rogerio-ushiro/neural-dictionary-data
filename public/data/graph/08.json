    "c_0214": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino che sta per nascere o appena nato.",
        "example": "Prepararono la cameretta per il nascituro."
      }
    },
    "c_0544": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La linea che separa due territori; al figurato, il limite di ciò che è lecito.",
        "example": "Il fiume segna il confine tra le due province."
      }
    },
    "c_0885": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Pelo lungo e ruvido, come quello della coda o della criniera del cavallo.",
        "example": "Gli archi si tendono con crine di cavallo."
      }
    }
  },

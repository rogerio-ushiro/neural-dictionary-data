{
  "shard": "c5",
  "concepts": {
    "c_0208": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle persone che vivono insieme secondo regole comuni.",
        "example": "In quella società contadina il lavoro si divideva per stagioni."
      }
    },
    "c_0301": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Territorio protetto in cui piante e animali vivono senza essere disturbati; anche una scorta messa da parte.",
        "example": "Nella riserva è vietato cacciare e raccogliere fiori."
      }
    },
    "c_0558": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Salto verticale del terreno da cui si può cadere.",
        "example": "Si sporse dal precipizio per guardare il fondovalle."
      }
    },
    "c_0851": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che riguarda gli esseri viventi e i loro processi vitali.",
        "example": "L'orologio biologico regola il ritmo del sonno."
      }
    }
  },

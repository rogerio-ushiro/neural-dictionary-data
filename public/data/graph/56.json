      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il grado di caldo o di freddo di un corpo o di un ambiente, misurato in gradi.",
        "example": "Con la febbre la temperatura corporea sale sopra i trentasette."
      }
    }

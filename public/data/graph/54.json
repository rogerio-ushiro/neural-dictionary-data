  "concepts": {
    "c_0210": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Bambino nei primissimi anni di vita, che ancora non parla.",
        "example": "L'infante dormiva nella culla accanto al letto."
      }
    },
    "c_0540": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Punta di terra che si spinge nel mare, di solito alta e rocciosa.",
        "example": "Doppiarono il capo con il mare grosso."
      }
    },
    "c_0881": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che sta in disparte, lontano dagli altri e dal rumore.",
        "example": "Si sono comprati una casa appartata in mezzo agli ulivi."
      }
    }
  },

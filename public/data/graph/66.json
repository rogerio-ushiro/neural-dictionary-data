  "concepts": {
    "c_0432": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il senso con cui si percepisce il sapore dei cibi; anche il senso estetico che guida le scelte.",
        "example": "Ha buon gusto nell'arredare la casa."
      }
    },
    "c_0447": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sottile biscotto secco e salato che si mangia con formaggi o salse.",
        "example": "Servì i cracker con un piattino di olive."
      }
    },
    "c_0656": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lo stato di riposo in cui si cade addormentandosi, con i sensi sospesi.",
        "example": "Cadde in un sonno profondo appena si sdraiò."
      }
    },
    "c_0920": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciò che una causa produce; la conseguenza di un fatto.",
        "example": "L'aumento dei prezzi è un effetto della siccità."
      }
    },
    "c_0995": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Combinazione di più suoni che, uditi insieme, risultano gradevoli.",
        "example": "Suonò un accordo di chitarra per accordare gli strumenti."
      }
    }
  },

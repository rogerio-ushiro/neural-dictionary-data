  "concepts": {
    "c_0317": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il muoversi velocemente a piedi; anche una gara di velocità o, al figurato, una fretta affannosa.",
        "example": "Ha fatto una corsa per non perdere l'autobus."
      }
    },
    "c_0380": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Minute gocce d'acqua che si depositano al mattino su erba e foglie per il raffreddamento notturno.",
        "example": "L'erba era bagnata di rugiada all'alba."
      }
    },
    "c_0847": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Proprio di chi agisce con violenza cieca e senza pietà.",
        "example": "Fu un gesto brutale e ingiustificato."
      }
    },
    "c_1031": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il lento consumarsi del terreno o della roccia per l'azione dell'acqua e del vento.",
        "example": "L'erosione ha arretrato la spiaggia di diversi metri."
      }
    }
  },

  "concepts": {
    "c_0236": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La madre del padre o della madre.",
        "example": "La nonna raccontava sempre storie di quando era ragazza."
      }
    },
    "c_0283": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi ha stima e ammirazione per qualcuno.",
        "example": "Alla conferenza c'erano molti suoi estimatori."
      }
    },
    "c_0412": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Distesa d'acqua ferma e poco profonda, più piccola di un lago.",
        "example": "Le rane gracidavano nello stagno dietro il casale."
      }
    },
    "c_0566": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Isola molto piccola.",
        "example": "Su quell'isoletta non abita nessuno tutto l'anno."
      }
    },
    "c_0694": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lunga fila di persone e animali da soma che viaggiano insieme attraverso zone deserte.",
        "example": "La carovana si fermò all'oasi per abbeverare i cammelli."
      }
    },
    "c_0957": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme dei gusti nel vestire e nei costumi che si diffondono in un periodo e poi passano.",
        "example": "Quei pantaloni larghi sono tornati di moda."
      }
    }
  },

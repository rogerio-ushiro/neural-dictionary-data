{
  "shard": "05",
  "concepts": {
    "c_0198": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La linea di discendenza di una famiglia, i suoi antenati.",
        "example": "Poteva far risalire il proprio lignaggio a un antico feudatario."
      }
    },
    "c_0244": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Persona avanti con gli anni.",
        "example": "Il vecchio sedeva sulla panchina a guardare i passanti."
      }
    },
    "c_0514": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La parte del giorno tra il mezzogiorno e la sera.",
        "example": "Il pomeriggio lo dedica ai compiti e allo sport."
      }
    },
    "c_1012": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Spostarsi sull'acqua con una barca o una nave; anche muoversi tra le pagine di internet.",
        "example": "Impararono a navigare a vela durante l'estate."
      }
    }
  },

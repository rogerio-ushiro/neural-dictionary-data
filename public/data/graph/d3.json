{
  "shard": "d3",
  "concepts": {
    "c_0149": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il chiudere e proteggere merci in involucri per il trasporto o la vendita.",
        "example": "L'imballaggio del vetro va fatto con cura."
      }
    },
    "c_0431": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La sensazione che un cibo dà in bocca, dolce, salato, amaro o acido.",
        "example": "La minestra aveva un sapore delicato di verdure fresche."
      }
    },
    "c_0444": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Panino dolce e soffio a base di burro e uova, tipico della colazione.",
        "example": "Al bar prese un cappuccino e una brioche calda."
      }
    },
    "c_0655": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Debolezza e spossatezza, per il caldo, la fame o la malinconia.",
        "example": "Il caldo gli dava un languore che lo faceva desiderare solo di dormire."
      }
    },
    "c_0758": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualcosa che esiste come cosa a sé, spesso astratta o difficile da definire.",
        "example": "Lo Stato è un'entità che sopravvive ai singoli governi."
      }
    },
    "c_0923": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il contorno di un viso o di una figura visti di lato.",
        "example": "Riconobbe il suo profilo contro la finestra."
      }
    },
    "c_0996": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Voce alta e improvvisa emessa per paura, dolore o richiamo.",
        "example": "Un grido nel buio fece accorrere i vicini."
      }
    }
  },

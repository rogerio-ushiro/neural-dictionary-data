{
  "shard": "40",
  "concepts": {
    "c_0148": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Striscia di tessuto o cinghia che sorregge una borsa o uno zaino sulla spalla.",
        "example": "La spallina dello zaino gli segava il collo."
      }
    },
    "c_0430": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il mobile su cui si mangia; per estensione, il pranzo stesso e chi vi partecipa.",
        "example": "A tavola non si parla con la bocca piena."
      }
    },
    "c_0445": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo dolce secco e croccante da inzuppare nel latte o nel caffè.",
        "example": "A colazione inzuppava tre biscotti nella tazza."
      }
    },
    "c_0654": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il non essercene abbastanza; penuria di qualcosa di necessario.",
        "example": "La scarsità di piogge ha fatto salire il prezzo del grano."
      }
    },
    "c_0759": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che è destinato a morire, come ogni essere umano.",
        "example": "Anche gli eroi sono creature mortali."
      }
    },
    "c_0922": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Contrasto tra zone di luce e zone d'ombra in un dipinto o in un ambiente.",
        "example": "Il pittore era maestro nel chiaroscuro."
      }
    },
    "c_0997": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di piccoli scoppi secchi e ripetuti.",
        "example": "Si sentiva il crepitio della legna nel camino."
      }
    }
  },

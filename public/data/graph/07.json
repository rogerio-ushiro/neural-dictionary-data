{
  "shard": "07",
  "concepts": {
    "c_0314": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il portare persone o cose da un luogo a un altro con un mezzo; indica anche uno slancio improvviso di affetto o entusiasmo.",
        "example": "Il trasporto delle merci avviene di notte."
      }
    },
    "c_0383": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tristezza vaga e senza causa precisa, spesso venata di dolcezza.",
        "example": "Le giornate di pioggia gli mettevano addosso una certa malinconia."
      }
    },
    "c_0844": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Belva feroce e temibile, spesso di grossa taglia.",
        "example": "Nella leggenda l'eroe affronta una belva mostruosa."
      }
    },
    "c_1032": {
      "revision": 2,
      "region_id": "r_corpo",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rottura della pelle e dei tessuti provocata da un colpo, un taglio o un'arma; al figurato, un dolore che rimane a lungo.",
        "example": "La ferita al ginocchio si e rimarginata in una settimana."
      }
    }
  },

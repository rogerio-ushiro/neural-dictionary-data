{
  "shard": "28",
  "concepts": {
    "c_0049": {
      "revision": 3,
      "region_id": null,
      "status_fronteira": "expanded",
      "definition": {
        "text": "Piccola imbarcazione a remi, a vela o a motore, usata per la pesca o per brevi tragitti sull'acqua.",
        "example": "Hanno noleggiato una barca per fare il giro del lago."
      }
    },
    "c_0311": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Struttura portante di una bicicletta o di una macchina, a cui si fissano le altre parti.",
        "example": "Il telaio in alluminio rende la bici leggerissima."
      }
    },
    "c_0386": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'azione di togliere lo sporco con acqua; al figurato, un ripulire da colpe o accuse.",
        "example": "Una bella pioggia ha dato un lavaggio a tutta la città."
      }
    },
    "c_0841": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo animale col corpo diviso in tre parti e sei zampe, come la formica e la mosca.",
        "example": "Un insetto ronzava contro il vetro della lampada."
      }
    },
    "c_1037": {
      "revision": 2,
      "region_id": "r_relazioni_sociali",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gesto o parola che si scambia incontrando qualcuno o lasciandolo.",
        "example": "Fece un cenno di saluto dal finestrino mentre il treno partiva."
      }
    }
  },

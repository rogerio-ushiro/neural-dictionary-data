      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Amico strettissimo, con cui si condivide tutto.",
        "example": "Solo un amico intimo poteva permettersi quella battuta."
      }
    },
    "c_0342": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'attività di far crescere piante utili lavorando il terreno.",
        "example": "Si dedica alla coltivazione degli ulivi da quando è in pensione."
      }
    },
    "c_0526": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che viene prima di tutti gli altri nel tempo o nell'ordine.",
        "example": "Fu il primo ad arrivare e l'ultimo ad andarsene."
      }
    },

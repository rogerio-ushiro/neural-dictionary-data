  "concepts": {
    "c_0047": {
      "revision": 3,
      "region_id": null,
      "status_fronteira": "expanded",
      "definition": {
        "text": "Grande imbarcazione capace di trasportare per mare molte persone o merci pesanti.",
        "example": "La nave salpò dal porto al tramonto."
      }
    },
    "c_0388": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vento leggero e piacevole che rinfresca senza dare fastidio.",
        "example": "Dal mare saliva una brezza serale."
      }
    },
    "c_1039": {
      "revision": 2,
      "region_id": "r_movimento",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Barra di metallo su cui scorrono le ruote del treno, posata in coppia lungo la linea.",
        "example": "Il carrello sferragliava a ogni giunzione delle rotaie."
      }
    }
  },

  "concepts": {
    "c_0155": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vasta area urbana formata da più città cresciute fino a saldarsi.",
        "example": "La conurbazione si estende senza soluzione di continuità per chilometri."
      }
    },
    "c_0649": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Screpolatura sottile che si apre in una superficie disseccata.",
        "example": "Il caldo aveva coperto il fango del fondale di screpolature."
      }
    },
    "c_0722": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Oggetto piatto e circolare; anche il supporto rotondo su cui si registrava la musica.",
        "example": "Il freno agisce stringendo il disco della ruota."
      }
    }
  },

{
  "shard": "fe",
  "concepts": {
    "c_0137": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Beni trasportati da un mezzo per essere consegnati altrove.",
        "example": "Il treno merci passa di notte per non intralciare i passeggeri."
      }
    },
    "c_0142": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Contenitore di pelle o stoffa con manici, usato per portare oggetti a mano; anche il luogo dove si scambiano titoli e azioni.",
        "example": "Ha infilato la spesa in una borsa di tela."
      }
    },
    "c_0753": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Essere che ha vita, che nasce, si nutre e muore.",
        "example": "Ogni essere vivente ha bisogno di acqua."
      }
    },
    "c_0928": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccola goccia che cade lentamente, una alla volta.",
        "example": "Dal rubinetto chiuso male cadeva una stilla ogni tanto."
      }
    }
  },

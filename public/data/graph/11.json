  "concepts": {
    "c_0204": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme dei figli, la discendenza di una coppia.",
        "example": "Ha cresciuto una numerosa prole con pochi mezzi."
      }
    },
    "c_0554": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Roccia alta e scoscesa, quasi a strapiombo.",
        "example": "L'aquila aveva il nido su una rupe inaccessibile."
      }
    },
    "c_1027": {
      "revision": 2,
      "region_id": "r_natura",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sostanza che dà il colore verde alle foglie e consente alle piante di ricavare nutrimento dalla luce.",
        "example": "In autunno la clorofilla si esaurisce e le foglie ingialliscono."
      }
    }
  },

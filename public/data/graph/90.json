{
  "shard": "90",
  "concepts": {
    "c_0041": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuna delle immense distese d'acqua salata che dividono i continenti; al figurato, una quantità enorme (un oceano di gente).",
        "example": "L'aereo sorvolò l'oceano per otto ore."
      }
    },
    "c_0319": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Essere vivente che si nutre, si muove e percepisce l'ambiente, distinto dalle piante; si usa anche per chi agisce in modo istintivo e senza freni.",
        "example": "In quella riserva vivono animali di ogni specie."
      }
    },
    "c_0849": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'alimentare i piccoli col latte materno nei primi mesi di vita.",
        "example": "Durante l'allattamento la madre ha bisogno di più riposo."
      }
    }
  },

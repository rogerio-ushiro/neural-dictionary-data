{
  "shard": "22",
  "concepts": {
    "c_0223": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il genitore di sesso maschile.",
        "example": "Il padre lo accompagnava a scuola in bici ogni mattina."
      }
    },
    "c_0256": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gruppo di alunni che seguono insieme le lezioni; anche uno dei livelli in cui si dividono le scuole.",
        "example": "Quest'anno è in una classe di venticinque ragazzi."
      }
    },
    "c_0397": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il punto più alto di un monte, di un albero o di qualsiasi cosa che si eleva.",
        "example": "Sulla cima sventolava una bandierina lasciata dagli scalatori."
      }
    },
    "c_0498": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Successione regolare di suoni e pause che dà l'andamento a una musica o a un discorso; indica anche la cadenza con cui si svolge un'attività.",
        "example": "Batteva il ritmo con il piede sotto il tavolo."
      }
    },
    "c_0506": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Oggetto costruito per produrre suoni musicali.",
        "example": "Ha imparato a suonare tre strumenti da autodidatta."
      }
    },
    "c_0573": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grande telo che, gonfiato dal vento, spinge avanti una barca.",
        "example": "Issarono la vela e la barca prese velocità."
      }
    },
    "c_0685": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'atto di scegliere tra più possibilità; anche la libertà di farlo.",
        "example": "Davanti a lui c'era una scelta difficile."
      }
    },
    "c_0960": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La volta del cielo con tutte le stelle che vi brillano di notte.",
        "example": "In campagna il firmamento è di una nitidezza rara."
      }
    },
    "c_1004": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Arresto di un movimento o di un processo che si prolunga.",
        "example": "Le trattative sono in una fase di stasi da settimane."
      }
    }
  },

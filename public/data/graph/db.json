{
  "shard": "db",
  "concepts": {
    "c_0185": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il camino acceso attorno a cui si raccoglie la famiglia; al figurato, la casa e gli affetti domestici.",
        "example": "D'inverno la sera si stava tutti intorno al focolare."
      }
    },
    "c_0259": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ciascuno dei libri di un'opera in più tomi; anche lo spazio occupato da un corpo.",
        "example": "Il dizionario è in due volumi."
      }
    },
    "c_0398": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rilievo del terreno alto e imponente; sinonimo di montagna.",
        "example": "Il monte era avvolto dalle nuvole fino a metà."
      }
    },
    "c_0400": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualsiasi parte del terreno che si eleva; anche l'importanza data a qualcosa.",
        "example": "La strada segue i rilievi della collina."
      }
    },
    "c_0497": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ampia composizione musicale per orchestra, divisa in più movimenti.",
        "example": "Al concerto eseguirono una sinfonia di Beethoven."
      }
    },
    "c_0509": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La luce incerta che c'è poco prima dell'alba o poco dopo il tramonto.",
        "example": "Rientrarono al crepuscolo, quando i primi lampioni si accendevano."
      }
    },
    "c_0611": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cilindro di cera con uno stoppino che, acceso, dà luce e un po' di calore finché non si consuma; nel motore, il pezzo che produce la scintilla per l'accensione.",
        "example": "Durante il blackout accesero qualche candela in cucina."
      }
    },
    "c_0664": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il periodo in cui le piante si coprono di fiori.",
        "example": "Ad aprile comincia la fioritura dei meli."
      }
    }
  },

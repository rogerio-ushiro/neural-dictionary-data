{
  "shard": "94",
  "concepts": {
    "c_0180": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La superficie della terra su cui si cammina e si costruisce; anche il territorio di un paese.",
        "example": "Piantò l'albero in un suolo ricco e umido."
      }
    },
    "c_0229": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Chi ha creato o realizzato un'opera; anche chi è all'origine di un fatto.",
        "example": "L'autore del romanzo firmava le copie in libreria."
      }
    },
    "c_0405": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Punto in cui si valica una catena di monti passando da una valle all'altra.",
        "example": "Il passo è chiuso al traffico d'inverno per la neve."
      }
    },
    "c_0492": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Incontro di più persone per discutere, festeggiare o lavorare insieme.",
        "example": "Domenica c'è la riunione di famiglia dai nonni."
      }
    },
    "c_0579": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tempesta di mare violenta e improvvisa.",
        "example": "La burrasca costrinse i pescherecci a rientrare."
      }
    },
    "c_0614": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Qualità di ciò che è nitido e ben distinguibile alla vista o alla mente.",
        "example": "Spiegò il problema con grande chiarezza."
      }
    },
    "c_0661": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Stato di intorpidimento in cui i sensi e i movimenti si fanno lenti, per freddo, stanchezza o pigrizia.",
        "example": "Il caldo del pomeriggio lo faceva cadere in un dolce torpore."
      }
    }
  },

{
  "shard": "7e",
  "concepts": {
    "c_0205": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Gruppo di famiglie che si riconoscono in un capostipite comune.",
        "example": "I due clan si contendevano il controllo della valle."
      }
    },
    "c_0555": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Parete di roccia a picco sul mare, spesso di gesso o calcare chiaro.",
        "example": "Le falesie bianche si vedevano dalla nave a miglia di distanza."
      }
    },
    "c_1026": {
      "revision": 2,
      "region_id": "r_natura",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grande corpo celeste che gira intorno a una stella senza emettere luce propria, come la Terra rispetto al Sole.",
        "example": "Con il telescopio si distingueva un pianeta poco sopra la Luna."
      }
    }
  },

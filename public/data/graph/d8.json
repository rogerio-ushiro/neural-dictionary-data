{
  "shard": "d8",
  "concepts": {
    "c_0135": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Disco o cerchio che gira attorno a un perno e permette a un veicolo di rotolare avanti; al figurato, l'elemento che fa funzionare un meccanismo più grande.",
        "example": "Una ruota della carriola si è sgonfiata."
      }
    },
    "c_0140": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme delle valigie e dei colli che ci si porta dietro in viaggio.",
        "example": "Ha imbarcato il bagaglio e si è diretto al gate."
      }
    },
    "c_0438": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Cereale da cui si ricava la farina per il pane; le sue spighe maturano d'estate.",
        "example": "I campi di grano ondeggiavano sotto il vento."
      }
    },
    "c_0751": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il liquido rosso che circola nel corpo; al figurato, la parentela e la discendenza.",
        "example": "Sono legati dallo stesso sangue."
      }
    }
  },

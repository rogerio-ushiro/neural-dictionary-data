  "shard": "ee",
  "concepts": {
    "c_0098": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Ferita della pelle causata dal fuoco, dal calore o da sostanze corrosive.",
        "example": "Si è procurato un'ustione al braccio con l'olio bollente."
      }
    },
    "c_0375": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La condizione degli esseri che nascono, crescono e si riproducono, in contrapposizione alle cose inanimate; anche il tempo che si trascorre esistendo.",
        "example": "Ha dedicato la vita all'insegnamento."
      }
    },
    "c_0825": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Che vive allo stato naturale, non addomesticato né coltivato; riferito a persone, rozzo e schivo.",
        "example": "In quella zona sopravvive ancora un gatto selvaggio."
      }
    }
  },

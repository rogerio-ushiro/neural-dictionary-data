  "concepts": {
    "c_0241": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il fratello del nonno o della nonna.",
        "example": "Il prozio emigrato in America mandava lettere a Natale."
      }
    },
    "c_0511": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il farsi buio dopo il tramonto.",
        "example": "All'imbrunire accesero le lanterne sul portico."
      }
    },
    "c_0609": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La possibilità di vedere lontano e distinguere le cose, che dipende dalla luce e dall'aria; in senso figurato, l'essere notato e conosciuto dal pubblico.",
        "example": "Con la nebbia la visibilità era ridotta a pochi metri."
      }
    },
    "c_1017": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Di dimensioni ridotte rispetto al normale.",
        "example": "Hanno una barca piccola, buona solo per il lago."
      }
    }
  },

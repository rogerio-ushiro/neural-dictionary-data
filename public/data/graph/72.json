      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'insieme di chi discende da un antenato comune.",
        "example": "La discendenza del vecchio conte si è estinta un secolo fa."
      }
    },
    "c_0245": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Scuola superiore che prepara agli studi universitari, con indirizzo classico, scientifico o linguistico.",
        "example": "Al liceo ha studiato latino per cinque anni."
      }
    },
    "c_0515": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Consumare il pasto della sera.",
        "example": "D'estate cenano sempre in terrazza."
      }
    },
    "c_1013": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sciogliere gli ormeggi e partire con la nave.",
        "example": "La nave salperà con l'alta marea."
      }
    }
  },

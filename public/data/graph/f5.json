{
  "shard": "f5",
  "concepts": {
    "c_0059": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grande ombrello piantato nella sabbia per ripararsi dal sole in spiaggia.",
        "example": "Sotto l'ombrellone si stava freschi anche a mezzogiorno."
      }
    },
    "c_0455": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Frutto a grappoli con cui si fa il vino, dolce e succoso.",
        "example": "Vendemmiarono l'uva nell'ultima settimana di settembre."
      }
    },
    "c_0626": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il volgere al termine, come il sole verso il tramonto.",
        "example": "Con il declinare della luce rientrarono all'accampamento."
      }
    },
    "c_0741": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Casa di campagna con i terreni e le stalle annesse.",
        "example": "La cascina è circondata da campi di mais."
      }
    },
    "c_0983": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "La qualità di ciò che è appena nato o inventato e non ha ancora perso freschezza.",
        "example": "La novellezza dell'idea entusiasmò tutti."
      }
    }
  },

{
  "shard": "4d",
  "concepts": {
    "c_0183": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il luogo dove una persona risulta abitare ufficialmente.",
        "example": "Ha eletto domicilio presso lo studio dell'avvocato."
      }
    },
    "c_0406": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Grande valle chiusa tra alte montagne.",
        "example": "Il torrente scorre in fondo al vallone."
      }
    },
    "c_0491": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Rappresentazione offerta al pubblico per stupirlo o divertirlo; anche una scena straordinaria da vedere.",
        "example": "Il tramonto dal molo era uno spettacolo."
      }
    },
    "c_0617": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Insieme di piccoli lampi di luce che tremolano.",
        "example": "Il brillio delle stelle si specchiava nel lago."
      }
    },
    "c_0662": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sospensione temporanea di un combattimento o di una fatica.",
        "example": "Le due squadre si concessero una breve tregua."
      }
    },
    "c_0969": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Freddo pungente e tagliente.",
        "example": "Un'algidità improvvisa gli attraversò la schiena."
      }
    }
  },

{
  "shard": "8b",
  "concepts": {
    "c_0167": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo centro abitato antico, spesso raccolto attorno a un castello o a una chiesa.",
        "example": "Il borgo è arroccato sulla collina sopra la valle."
      }
    },
    "c_0673": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Sensazione di appagamento che dà gioia e benessere.",
        "example": "Provava un vero piacere nell'aiutare gli altri."
      }
    },
    "c_0699": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Serie di persone o cose disposte una dietro l'altra.",
        "example": "C'era una lunga fila alla cassa del supermercato."
      }
    },
    "c_0736": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Piccolo agglomerato di case che fa parte di un comune ma è staccato dal centro.",
        "example": "La frazione ha una chiesetta e nient'altro."
      }
    }
  },

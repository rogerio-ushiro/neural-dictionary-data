  "concepts": {
    "c_0166": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Locale o edificio dove si svolge un lavoro d'amministrazione; anche la carica che si ricopre.",
        "example": "Esce dall'ufficio verso le sei."
      }
    },
    "c_0672": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Il sottrarsi, anche solo con la mente, agli obblighi e alla routine.",
        "example": "Per lui il cinema è una forma di evasione."
      }
    },
    "c_0698": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Musica o parte strumentale che sostiene un canto o una scena.",
        "example": "Cantò la canzone con l'accompagnamento della chitarra."
      }
    },
    "c_0737": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "L'ente che amministra un territorio e i suoi abitanti; il più piccolo dello Stato.",
        "example": "Il comune ha stanziato i fondi per la nuova scuola."
      }
    }
  },

{
  "shard": "2d",
  "concepts": {
    "c_0316": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Involucro di gomma pieno d'aria che riveste la ruota di un veicolo e ne ammortizza la corsa.",
        "example": "Ha forato uno pneumatico su una buca."
      }
    },
    "c_0381": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Lo spazio che sovrasta la terra, dove si vedono sole, nuvole e stelle; nelle religioni, la sede di Dio e dei beati.",
        "example": "Il cielo si è coperto all'improvviso."
      }
    },
    "c_0846": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Proprio delle belve, per aspetto o istinti feroci.",
        "example": "Aveva uno sguardo ferino quando si arrabbiava."
      }
    },
    "c_1030": {
      "revision": 2,
      "region_id": "r_oggetti",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Impianto o elettrodomestico chiuso in cui si concentra il calore per cuocere cibi o lavorare materiali; al figurato, un ambiente rovente.",
        "example": "Ha infornato il pane e ha chiuso lo sportello del forno."
      }
    }
  },

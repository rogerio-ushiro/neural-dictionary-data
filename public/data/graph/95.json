{
  "shard": "95",
  "concepts": {
    "c_0046": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Tratto di costa riparato e attrezzato dove le navi attraccano per caricare e scaricare.",
        "example": "Il traghetto entrò in porto con mezz'ora di ritardo."
      }
    },
    "c_0389": {
      "revision": 2,
      "region_id": null,
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Breve emissione d'aria dalla bocca o di vento leggero.",
        "example": "Spense le candeline con un soffio."
      }
    },
    "c_1038": {
      "revision": 2,
      "region_id": "r_movimento",
      "status_fronteira": "needs_expansion",
      "definition": {
        "text": "Vettura chiusa di un treno dove viaggiano i passeggeri; un tempo, il veicolo tirato dai cavalli.",
        "example": "Salirono nell'ultima carrozza, quasi vuota."
      }
    }
  },

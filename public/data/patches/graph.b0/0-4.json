  "ops": [
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0225",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "La madre, chi ha messo al mondo un figlio (voce elevata).",
          "example": "Perse la genitrice quando era ancora bambino."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0250",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "L'attività di chi trasmette conoscenze e metodi a chi impara; anche ciò che una vicenda ci lascia capire.",
          "example": "Ha dedicato quarant'anni all'insegnamento della matematica."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0391",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il muoversi ripetuto avanti e indietro attorno a un punto fisso, come quello di un pendolo o di un ramo al vento.",
          "example": "L'oscillazione della barca gli diede la nausea."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0409",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "L'aspetto d'insieme di un tratto di territorio così come si presenta alla vista.",
          "example": "Dalla cima si godeva un paesaggio di valli e boschi."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0500",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Breve componimento di parole cantate su una melodia, che si ascolta, si canticchia o si balla; in tono scherzoso, un discorso ripetuto e noioso (la solita canzone).",
          "example": "Alla radio passava una canzone che conosceva a memoria."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0575",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Dispositivo con cui si dirige un'imbarcazione o un aereo facendogli cambiare rotta; in senso figurato, la guida di un'impresa o di un governo.",
          "example": "Il comandante teneva saldo il timone durante la tempesta."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0618",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "L'insieme delle condizioni dell'atmosfera in un luogo, come sole, pioggia e vento; anche il trascorrere delle ore e degli anni.",
          "example": "Il tempo è cambiato all'improvviso nel pomeriggio."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0683",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Ciò che a qualcuno spetta per legge o per giustizia e che può pretendere.",
          "example": "Ogni cittadino ha diritto all'istruzione."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0966",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il colore del cielo sereno, tra il blu e il celeste.",
          "example": "Indossava una camicia azzurra."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_1002",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Calma serena e distesa.",
          "example": "Sul viso del vecchio c'era una placidità che rassicurava."
        }
      }
    },

        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Permesso ufficiale di fare o esercitare qualcosa; anche un eccesso di libertà nei modi.",
          "example": "Ha ottenuto la licenza per aprire il locale."
        }
      }
    },
    {

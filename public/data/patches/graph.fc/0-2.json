      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "La copertura superiore di un edificio, che ripara da pioggia e sole.",
          "example": "Il vento aveva scoperchiato una parte del tetto."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0221",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il piccolo del cane e di altri mammiferi; con affetto, un bambino.",
          "example": "Il cucciolo mordicchiava le pantofole di tutti."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0254",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il processo con cui una persona acquisisce conoscenze e capacità per una professione.",
          "example": "Ha seguito un corso di formazione per infermieri."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0395",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il punto più alto di una montagna.",
          "example": "Raggiunsero la vetta poco prima di mezzogiorno."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0504",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "L'emettere con la voce suoni musicali; anche il brano che si canta.",
          "example": "Dai campi saliva il canto dei mietitori."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0571",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "La direzione da tenere durante un viaggio per mare o per aria; al figurato, la linea di condotta scelta.",
          "example": "Il comandante corresse la rotta per evitare la tempesta."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",

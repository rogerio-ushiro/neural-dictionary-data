    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0030",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Aria in movimento che soffia sul terreno, muove le foglie e spinge le vele; in senso figurato, qualcosa di leggero e privo di consistenza (parole al vento).",
          "example": "Il vento ha spalancato le imposte durante la notte."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0368",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Corso d'acqua naturale che scorre tra due sponde fino a sfociare nel mare o in un lago; al figurato, un flusso abbondante e continuo (un fiume di parole).",
          "example": "Il fiume è in piena dopo giorni di pioggia."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0838",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Animale provvisto di colonna vertebrale, come pesci, uccelli e mammiferi.",
          "example": "I rettili sono vertebrati a sangue freddo."
        }
      }
    },

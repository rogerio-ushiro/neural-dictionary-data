        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Rilievo del terreno più basso e più dolce di una montagna.",
          "example": "Le vigne coprono i fianchi della collina fino alla cima."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",

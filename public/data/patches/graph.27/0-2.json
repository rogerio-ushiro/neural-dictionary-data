        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il luogo dove si vive stabilmente, la propria casa.",
          "example": "Ha cambiato abitazione per avvicinarsi al lavoro."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0228",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Antenato da cui si discende; anche l'influenza o il prestigio che si esercita sugli altri.",
          "example": "Ha un forte ascendente sui più giovani."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",

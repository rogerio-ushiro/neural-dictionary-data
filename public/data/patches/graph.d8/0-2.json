        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Cereale da cui si ricava la farina per il pane; le sue spighe maturano d'estate.",
          "example": "I campi di grano ondeggiavano sotto il vento."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",

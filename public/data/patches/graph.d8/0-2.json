        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Disco o cerchio che gira attorno a un perno e permette a un veicolo di rotolare avanti; al figurato, l'elemento che fa funzionare un meccanismo più grande.",
          "example": "Una ruota della carriola si è sgonfiata."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0140",

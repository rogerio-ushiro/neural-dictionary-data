        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "L'insieme delle valigie e dei colli che ci si porta dietro in viaggio.",
          "example": "Ha imbarcato il bagaglio e si è diretto al gate."
        }
      }
    },
    {

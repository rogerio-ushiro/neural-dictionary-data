      "concept_id": "c_0189",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Riparo che gli uccelli costruiscono per deporre le uova e allevare i piccoli; al figurato, la casa accogliente.",
          "example": "Sul cornicione due rondini avevano fatto il nido."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0220",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Piccolo del pollo appena nato; scherzosamente, un bambino indifeso.",
          "example": "La chioccia teneva i pulcini al riparo sotto le ali."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0255",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Ufficio o carica di maestro; anche la facoltà che formava gli insegnanti.",
          "example": "Si laureò in magistero per diventare maestra elementare."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0394",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Movimento disordinato e vorticoso dell'aria o dell'acqua; al figurato, un periodo agitato e privo di stabilità.",
          "example": "L'aereo attraversò una zona di turbolenza."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0505",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Complesso di musicisti che suonano insieme sotto la guida di un direttore.",
          "example": "L'orchestra accordò gli strumenti prima dell'ingresso del maestro."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0570",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Il percorrere per intero un mare o un tratto d'acqua da una sponda all'altra.",
          "example": "La traversata dello stretto dura quaranta minuti."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0668",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Fiducia serena che qualcosa di buono debba accadere.",
          "example": "Non ha mai perso la speranza di rivederli."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0686",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Esenzione da un obbligo, un dazio o una tassa.",
          "example": "I bagagli entro i venti chili viaggiano in franchigia."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0963",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "L'estensione vuota e sconfinata oltre l'atmosfera terrestre, dove si muovono i pianeti.",
          "example": "Il satellite fu lanciato nello spazio dal poligono."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_1007",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Calma completa del mare, senza un filo di vento.",
          "example": "In piena bonaccia le vele pendevano flosce."
        }
      }

        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Caduta di gocce d'acqua dalle nuvole; al figurato, qualcosa che arriva in grande quantità e senza sosta (una pioggia di critiche).",
          "example": "La pioggia batteva forte sui vetri."
        }
      }
    },
    {
      "op": "ADD_CONCEPT",
      "concept_id": "c_0371",
      "concept": {
        "revision": 2,
        "region_id": null,
        "status_fronteira": "needs_expansion",
        "definition": {
          "text": "Ciascuna delle parti di base che, unite ad altre, compongono un tutto; nell'antichità, una delle sostanze fondamentali come acqua e fuoco.",
          "example": "La fiducia è un elemento essenziale in ogni squadra."
        }
      }
    },

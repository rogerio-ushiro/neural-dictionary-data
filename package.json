{
  "name": "@neural-dictionary/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Data-access client for the neural-dictionary app: model, offline-first loader, ego-graph, search. Also home of the generation/growth pipeline (not published).",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepare": "npm run build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "generate": "tsx --env-file-if-exists=.env scripts/generate/index.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
